# ---- main menu
tui_main() {
  need_root
  ui_tty || die "The menu needs an interactive terminal. CLI help: vpn help"
  [[ -f $CONF ]] || die "Not installed yet. Run the installer first."
  while true; do
    ui_header "IKEv2 VPN Manager  v$VERSION"
    echo; ui_dash; echo
    ui_item 1 "Users & client profiles"
    ui_item 2 "Status & connected clients"
    ui_item 3 "Server, certificates, domain"
    ui_item 4 "Advanced strongSwan settings (DNS, proposals, timers, raw)"
    ui_item 5 "Telegram bot"
    ui_item 6 "Security (firewall, fail2ban, auto-updates)"
    ui_item 7 "Backup & restore"
    ui_item 8 "Updates"
    ui_item 9 "Uninstall"
    ui_item 0 "Exit"
    ui_choose
    case $CHOICE in
      1) tui_users ;;
      2) tui_status ;;
      3) tui_server ;;
      4) tui_advanced ;;
      5) tui_bot ;;
      6) tui_security ;;
      7) tui_backup ;;
      8) tui_update ;;
      9) echo; warn " This removes the VPN manager, bot and firewall rules (a final backup is made first)."
