# ------------------------------------------------------------ telegram bot management
tg_api() { # method [curl args...]
  local m="$1"; shift
  curl -s --max-time 15 "https://api.telegram.org/bot${BOT_TOKEN}/$m" "$@"
}

bot_validate_token() { # token -> prints bot username
  local r
  r=$(curl -s --max-time 15 "https://api.telegram.org/bot$1/getMe") || return 1
  grep -q '"ok":true' <<<"$r" || return 1
  grep -oE '"username":"[^"]+"' <<<"$r" | head -1 | cut -d'"' -f4
}

cmd_bot() {
  need_root
  cfg_load
  case "${1:-status}" in
    setup)
      local tok="${2:-}" aid="${3:-}" uname
      [[ -n $tok && -n $aid ]] || die "Usage: vpn bot setup TOKEN ADMIN_ID"
      [[ $aid =~ ^[0-9]+$ ]] || die "ADMIN_ID must be a numeric Telegram user id."
      uname=$(bot_validate_token "$tok") || die "Telegram rejected this token (or no internet)."
      cfg_set BOT_TOKEN "$tok"; cfg_set ADMIN_ID "$aid"
      install_units
      systemctl enable --now ikev2-bot >/dev/null 2>&1 || die "Could not start ikev2-bot"
      systemctl restart ikev2-bot
      ok "Bot @$uname is running. Open Telegram, send /start to it from account $aid." ;;
    on)  [[ -n $BOT_TOKEN ]] || die "Run: vpn bot setup TOKEN ADMIN_ID"; systemctl enable --now ikev2-bot; ok "Bot enabled." ;;
    off) systemctl disable --now ikev2-bot 2>/dev/null; ok "Bot disabled." ;;
    status)
      say "Configured: $([[ -n $BOT_TOKEN ]] && echo yes || echo no)   Admin id: ${ADMIN_ID:-none}"
      say "Service:    $(systemctl is-active ikev2-bot 2>/dev/null || echo inactive)" ;;
    test)
      [[ -n $BOT_TOKEN && -n $ADMIN_ID ]] || die "Bot is not configured."
      tg_api sendMessage -d "chat_id=$ADMIN_ID" --data-urlencode "text=✅ Test message from $(hostname) (vpn v$VERSION)" | grep -q '"ok":true' \
        && ok "Test message sent." || die "Sending failed (check token / start the bot chat first)." ;;
    logs) journalctl -u ikev2-bot -n "${2:-60}" --no-pager ;;
    *) die "Usage: vpn bot setup|on|off|status|test|logs" ;;
  esac
}

