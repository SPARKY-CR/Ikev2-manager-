}

gen_windows_ps1() { # name
  local name="$1" import=""
  if [[ $MODE == ip ]]; then
    import="
# Trust the VPN CA certificate
\$certB64 = \"$(ca_der_b64)\"
\$tmp = Join-Path \$env:TEMP \"ikev2-ca.cer\"
[IO.File]::WriteAllBytes(\$tmp, [Convert]::FromBase64String(\$certB64))
Import-Certificate -FilePath \$tmp -CertStoreLocation Cert:\\LocalMachine\\Root | Out-Null
Remove-Item \$tmp
"
  fi
  cat <<EOF
# IKEv2 VPN setup for Windows. Run in PowerShell *as Administrator*.
# Username: $name  (you will be asked for the password on first connect)
\$ErrorActionPreference = "Stop"
\$Name = "VPN $SERVER_NAME"
\$Server = "$SERVER_NAME"
$import
Add-VpnConnection -Name \$Name -ServerAddress \$Server -TunnelType IKEv2 \`
  -AuthenticationMethod MSChapv2 -EncryptionLevel Required -RememberCredential -Force
Set-VpnConnectionIPsecConfiguration -ConnectionName \$Name \`
  -AuthenticationTransformConstants SHA256128 -CipherTransformConstants AES128 \`
  -EncryptionMethod AES128 -IntegrityCheckMethod SHA256 -PfsGroup None -DHGroup Group14 -Force

Write-Host "Done. Connect via Settings > Network & Internet > VPN > \$Name"
Write-Host "Username: $name"
EOF
}

zed_link() { # name [nopw]
  local name="$1" pass cafile=""
  pass=$(user_get "$name" 2); [[ ${2:-} == nopw ]] && pass=""
  [[ $MODE == ip ]] && cafile="$PKI/ca.pem"
  python3 "$OPT/ikev2lib.py" zedsecure "VPN $SERVER_NAME ($name)" "$SERVER_NAME" "$name" "$pass" "$cafile"
}

gen_zed_file() { # name pass
  local name="$1" pass="$2"
  cat <<EOF
ZedSecure - IKEv2 import link
=============================
1) Copy the whole link below (long press > select all > copy).
2) Open ZedSecure and import it from the clipboard.

Link (includes the password):
$(zed_link "$name")

If ZedSecure does not accept the password inside the link, import this one
and type the password yourself ($pass):
$(zed_link "$name" nopw)

Server:   $SERVER_NAME
Username: $name
$( [[ $MODE == ip ]] && echo "The CA certificate is embedded in the link (self-signed server certificate)." || echo "Public (Let's Encrypt) certificate: no CA needed." )
EOF
}

gen_readme() { # name pass
  local name="$1" pass="$2"
  cat <<EOF
IKEv2 VPN - connection info
===========================
Server:   $SERVER_NAME
Username: $name
Password: $pass
Type:     IKEv2 / EAP-MSCHAPv2

ANDROID - ZedSecure: import the link inside zedsecure-$name.txt (clipboard).

ANDROID (strongSwan VPN Client app, free on Google Play)
  1. Install the app, menu > "Import VPN profile", pick $name.sswan
  2. Enter the password above (the file does not contain it), tap Import.
$( [[ $MODE == ip ]] && echo "  (The CA certificate is embedded in the profile.)" )

IPHONE / IPAD / MAC
  1. Open $name.mobileconfig and install it (Settings > Profile Downloaded).
$( [[ $MODE == ip ]] && echo "  2. Settings > General > About > Certificate Trust Settings: enable full trust for \"$CA_CN\".
  3. Settings > VPN: turn the VPN on." || echo "  2. Settings > VPN: turn the VPN on." )

WINDOWS
  Run $name-windows.ps1 in PowerShell as Administrator, then connect from
  Settings > Network & Internet > VPN.
$( [[ $MODE == ip ]] && echo "
Manual setups: install ca.crt as a trusted root CA first." )
EOF
}

# profile_make NAME DIR
profile_make() {
  local name="$1" dir="$2" pass
  cfg_load
  [[ -n $SERVER_NAME ]] || die "Server is not configured."
  user_exists "$name" || die "No such user: $name"
  pass=$(user_get "$name" 2)
  mkdir -p "$dir"
  gen_sswan "$name" >"$dir/$name.sswan"
  gen_mobileconfig "$name" "$pass" >"$dir/$name.mobileconfig"
  gen_windows_ps1 "$name" >"$dir/$name-windows.ps1"
  gen_zed_file "$name" "$pass" >"$dir/zedsecure-$name.txt"
  gen_readme "$name" "$pass" >"$dir/README-$name.txt"
  [[ $MODE == ip ]] && cp -f "$PKI/ca.pem" "$dir/ca.crt"
  chmod 600 "$dir"/*
}

cmd_profile() {
  local name="${1:-}" dir="${2:-}"
  [[ -n $name ]] || die "Usage: vpn profile NAME [OUTPUT_DIR]"
  [[ -n $dir ]] || dir="$EXPORTS/$name"
  profile_make "$name" "$dir"
  ok "Profile files written to $dir"
  ls -1 "$dir"
}

cmd_zed() {
  local name="${1:-}" mode="${2:-}"
  [[ -n $name ]] || die "Usage: vpn zed NAME [--nopw]"
  user_exists "$name" || die "No such user: $name"
  cfg_load
  zed_link "$name" "$([[ $mode == --nopw ]] && echo nopw)"
}

cmd_ca() {
  cfg_load
  [[ $MODE == ip ]] || die "Domain mode uses a public certificate (Let's Encrypt); no CA file is needed."
  cat "$PKI/ca.pem"
}

# ------------------------------------------------------------ network / firewall
default_iface() { ip -4 route show default 2>/dev/null | awk '{print $5; exit}'; }

detect_public_ip() {
  local ip u
  for u in https://ifconfig.me https://api.ipify.org https://ipv4.icanhazip.com; do
    ip=$(curl -4 -s --max-time 8 "$u" 2>/dev/null | tr -d '[:space:]')
    if [[ $ip =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then echo "$ip"; return 0; fi
  done
  return 1
}

# ipt_ensure A|I TABLE CHAIN rule...   (idempotent)
IPT_TAG=(-m comment --comment ikev2-mgr)

# delete every rule we tagged ("ikev2-mgr") in TABLE CHAIN
ipt_purge() {
  local line arr
  while IFS= read -r line; do
    [[ $line == *ikev2-mgr* ]] || continue
    read -ra arr <<<"$line"; arr[0]=-D
    iptables -t "$1" "${arr[@]}" 2>/dev/null
  done < <(iptables -t "$1" -S "$2" 2>/dev/null | grep -- '^-A ')
}


fw_ssh_ports() {
  {
    ss -H -tlnp 2>/dev/null | awk '/sshd/{n=split($4,a,":"); print a[n]}'
    awk 'tolower($1)=="port" && $2 ~ /^[0-9]+$/ {print $2}' /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null
    [[ -n ${SSH_CONNECTION:-} ]] && echo "${SSH_CONNECTION##* }"
    echo 22
  } | grep -E '^[0-9]+$' | sort -un | tr '\n' ' ' | sed 's/ $//'
}

fw_remove() {
  local cmd
  for cmd in iptables ip6tables; do
    command -v "$cmd" >/dev/null || continue
    while "$cmd" -C INPUT -j IKEV2_FW 2>/dev/null; do "$cmd" -D INPUT -j IKEV2_FW; done
    "$cmd" -F IKEV2_FW 2>/dev/null; "$cmd" -X IKEV2_FW 2>/dev/null
  done
  return 0
}

fw_apply() {
  cfg_load
  if [[ $FIREWALL != yes ]]; then fw_remove; return 0; fi
  local cmd p icmp
  for cmd in iptables ip6tables; do
    command -v "$cmd" >/dev/null || continue
    "$cmd" -N IKEV2_FW 2>/dev/null || "$cmd" -F IKEV2_FW
    "$cmd" -A IKEV2_FW -i lo -j ACCEPT
    "$cmd" -A IKEV2_FW -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
    if [[ $cmd == iptables ]]; then icmp="icmp"; else icmp="ipv6-icmp"; fi
    "$cmd" -A IKEV2_FW -p "$icmp" -j ACCEPT
    for p in $FW_SSH_PORTS; do "$cmd" -A IKEV2_FW -p tcp --dport "$p" -j ACCEPT; done
    "$cmd" -A IKEV2_FW -p udp -m multiport --dports 500,4500 -j ACCEPT
    "$cmd" -A IKEV2_FW -p esp -j ACCEPT
    if [[ $cmd == iptables ]]; then
      "$cmd" -A IKEV2_FW -p udp --sport 67 --dport 68 -j ACCEPT
    else
      "$cmd" -A IKEV2_FW -p udp --dport 546 -j ACCEPT
    fi
    for p in ${FW_EXTRA_TCP//,/ }; do "$cmd" -A IKEV2_FW -p tcp --dport "$p" -j ACCEPT; done
    for p in ${FW_EXTRA_UDP//,/ }; do "$cmd" -A IKEV2_FW -p udp --dport "$p" -j ACCEPT; done
    "$cmd" -A IKEV2_FW -j DROP
    "$cmd" -C INPUT -j IKEV2_FW 2>/dev/null || "$cmd" -I INPUT 1 -j IKEV2_FW
  done
}

net_apply() {
  need_root
  cfg_load
  mkdir -p /etc/sysctl.d
  cat >/etc/sysctl.d/99-ikev2.conf <<EOF
net.ipv4.ip_forward=1
net.ipv4.conf.all.accept_redirects=0
net.ipv4.conf.all.send_redirects=0
EOF
  sysctl -q --system >/dev/null 2>&1 || sysctl -q -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
  local ifc; ifc=$(default_iface); [[ -n $ifc ]] || ifc="${IFACE:-eth0}"
  ipt_purge nat POSTROUTING; ipt_purge filter FORWARD; ipt_purge mangle FORWARD; ipt_purge filter INPUT
  if [[ $NAT == yes ]]; then
    iptables -t nat -A POSTROUTING -s "$POOL" -o "$ifc" "${IPT_TAG[@]}" -j MASQUERADE
  fi
  iptables -I FORWARD 1 -s "$POOL" "${IPT_TAG[@]}" -j ACCEPT
  iptables -I FORWARD 1 -d "$POOL" "${IPT_TAG[@]}" -j ACCEPT
  case "$MSS_CLAMP" in
    off) ;;
    pmtu) iptables -t mangle -A FORWARD -s "$POOL" -p tcp -m tcp --tcp-flags SYN,RST SYN "${IPT_TAG[@]}" -j TCPMSS --clamp-mss-to-pmtu ;;
    *)    iptables -t mangle -A FORWARD -s "$POOL" -p tcp -m tcp --tcp-flags SYN,RST SYN "${IPT_TAG[@]}" -j TCPMSS --set-mss "$MSS_CLAMP" ;;
  esac
  iptables -I INPUT 1 -p udp -m multiport --dports 500,4500 "${IPT_TAG[@]}" -j ACCEPT
  fw_apply
}

net_clear() {
  cfg_load
  ipt_purge nat POSTROUTING; ipt_purge filter FORWARD; ipt_purge mangle FORWARD; ipt_purge filter INPUT
  fw_remove
}

cmd_fw() {
  need_root
  cfg_load
  case "${1:-status}" in
    on)
      local ports; ports=$(fw_ssh_ports)
      cfg_set FW_SSH_PORTS "$ports"; cfg_set FIREWALL yes
      fw_apply; ok "Firewall enabled. Open inbound: TCP $ports (SSH), UDP 500/4500 (VPN)."
      [[ $MODE == domain ]] && say "Port 80 is opened automatically only while Let's Encrypt renews."
      warn "Cloud providers (AWS etc.) also have their own firewall (Security Group) - keep it in sync." ;;
    off)  cfg_set FIREWALL no; fw_apply; ok "Firewall disabled." ;;
    ports)
      [[ -n ${2:-} ]] || die "Usage: vpn fw ports \"22 2222\""
      [[ $2 =~ ^[0-9]+( [0-9]+)*$ ]] || die "Ports must be numbers separated by spaces."
      cfg_set FW_SSH_PORTS "$2"; fw_apply; ok "SSH ports set to: $2" ;;
    status)
      say "Firewall: $FIREWALL (SSH ports: $FW_SSH_PORTS)"
      iptables -S IKEV2_FW 2>/dev/null || say "(no IKEV2_FW chain active)" ;;
    *) die "Usage: vpn fw on|off|status|ports" ;;
  esac
}

