# ------------------------------------------------------------ telegram bot management
TOKEN_RE='^[0-9]{5,15}:[A-Za-z0-9_-]{20,100}$'

# The token is handed to curl through a config on stdin, so it never shows up in `ps` / /proc/*/cmdline.
tg_api() { # method [curl args...]
  local m="$1"; shift
  [[ $BOT_TOKEN =~ $TOKEN_RE ]] || return 1
  printf 'url = "https://api.telegram.org/bot%s/%s"\n' "$BOT_TOKEN" "$m" | curl -s --max-time 15 -K - "$@"
}

bot_validate_token() { # token -> prints bot username
  local r
  [[ $1 =~ $TOKEN_RE ]] || return 1
  r=$(printf 'url = "https://api.telegram.org/bot%s/getMe"\n' "$1" | curl -s --max-time 15 -K -) || return 1
  grep -q '"ok":true' <<<"$r" || return 1
  grep -oE '"username":"[^"]+"' <<<"$r" | head -1 | cut -d'"' -f4
}

cmd_bot() { need_root; locked _bot "$@"; }
_bot() {
  cfg_load
  case "${1:-status}" in
    setup)
      local tok="${2:-}" aid="${3:-}" uname
      [[ $tok == - ]] && { IFS= read -r tok || true; }
      [[ -n $tok && -n $aid ]] || die "Usage: vpn bot setup TOKEN|- ADMIN_ID   ('-' reads the token from stdin: keeps it out of the process list and shell history)"
      [[ $aid =~ ^[0-9]+$ ]] || die "ADMIN_ID must be a numeric Telegram user id."
      [[ $tok =~ $TOKEN_RE ]] || die "That does not look like a Telegram bot token (expected 123456789:AAxxxxxxxx...)."
      uname=$(bot_validate_token "$tok") || die "Telegram rejected this token (or no internet)."
      cfg_set BOT_TOKEN "$tok"; cfg_set ADMIN_ID "$aid"
      install_units
      systemctl enable --now ikev2-bot >/dev/null 2>&1 || die "Could not start ikev2-bot"
      systemctl restart ikev2-bot
      ok "Bot @$uname is running. Open Telegram, send /start to it from account $aid." ;;
    on)  [[ -n $BOT_TOKEN ]] || die "Run: vpn bot setup TOKEN ADMIN_ID"; systemctl enable --now ikev2-bot; ok "Bot enabled." ;;
    off) systemctl disable --now ikev2-bot 2>/dev/null; ok "Bot disabled." ;;
    status)
      say "Configured: $([[ -n $BOT_TOKEN ]] && echo yes || echo no)   Admin id: ${ADMIN_ID:-none}"
      say "Service:    $(systemctl is-active ikev2-bot 2>/dev/null || echo inactive)" ;;
    test)
      [[ -n $BOT_TOKEN && -n $ADMIN_ID ]] || die "Bot is not configured."
      tg_api sendMessage -d "chat_id=$ADMIN_ID" --data-urlencode "text=✅ Test message from $(hostname) (vpn v$VERSION)" | grep -q '"ok":true' \
        && ok "Test message sent." || die "Sending failed (check token / start the bot chat first)." ;;
    logs) journalctl -u ikev2-bot -n "${2:-60}" --no-pager ;;
    *) die "Usage: vpn bot setup|on|off|status|test|logs" ;;
  esac
}

# ------------------------------------------------------------ status
cmd_online() { python3 "$OPT/ikev2lib.py" online; }

cmd_status() {
  cfg_load
  local svc online users enabled days cstate cline bkey bot
  svc=$(svc_active); users=$(user_count); enabled=$(user_enabled_count)
  online=$(python3 "$OPT/ikev2lib.py" count 2>/dev/null || echo 0)
  days=$(cert_days_left); cstate=$(cert_state)
  [[ -f $BACKUP_PUB ]] && bkey=yes || bkey=no
  case "$cstate" in
    missing) cline="MISSING - run: vpn cert renew" ;;
    expired) cline="EXPIRED $(( -days )) day(s) ago - run: vpn cert renew" ;;
    *)       cline="$days days left" ;;
  esac
  bot=$(systemctl is-active ikev2-bot 2>/dev/null || echo inactive)
  if [[ ${1:-} == --kv ]]; then
    cat <<EOF
version=$VERSION
service=$svc
sw_version=$(sw_version)
mode=$MODE
server=$SERVER_NAME
users=$users
enabled=$enabled
online=$online
cert_days=$days
cert_state=$cstate
backup_key=$bkey
firewall=$FIREWALL
bot=$bot
pool=$POOL
dns=$DNS
fw_ports=$FW_SSH_PORTS
fail2ban=$FAIL2BAN
autoupdate=$AUTOUPDATE
quota_action=$QUOTA_ACTION
default_limit=$DEFAULT_LIMIT
default_days=$DEFAULT_DAYS
EOF
    return
  fi
  say "IKEv2 Manager v$VERSION"
  say "Service:       $svc"
  say "strongSwan:    $(sw_version)"
  say "Mode:          $MODE"
  say "Server:        $SERVER_NAME"
  say "Users:         $users ($enabled enabled), online now: $online"
  say "Certificate:   $cline"
  say "Backup key:    $bkey"
  say "Firewall:      $FIREWALL"
  say "Telegram bot:  $bot"
}

cmd_logs() {
  local n="${1:-80}"
  [[ $n =~ ^[1-9][0-9]{0,3}$ ]] || die "Usage: vpn logs [LINES]   (1-9999)"
  journalctl -u "$(svc_name)" -n "$n" --no-pager 2>/dev/null
}
cmd_restart() { need_root; svc_restart; sleep 1; run_swanctl --load-all >/dev/null 2>&1; ok "Service: $(svc_active)"; }

# ------------------------------------------------------------ advanced settings
CHARON_D="${IKEV2_STRONGSWAND:-/etc/strongswan.d}"

SETTING_KEYS=(DNS POOL LOCAL_TS IKE_PROPOSALS ESP_PROPOSALS DPD_DELAY FRAGMENTATION MOBIKE UNIQUE
  REKEY_TIME REAUTH_TIME CHILD_REKEY_TIME CHILD_LIFE_TIME SEND_CERT MSS_CLAMP NAT
  FW_EXTRA_TCP FW_EXTRA_UDP LOG_LEVEL CLIENT_ISOLATION BLOCK_PRIVATE IKE_RATE_LIMIT IPV6_BLOCK
  QUOTA_ACTION DEFAULT_LIMIT DEFAULT_DAYS)

declare -A S_DESC=(
  [DNS]='DNS servers pushed to clients'
  [POOL]='Virtual IP range handed to clients'
  [LOCAL_TS]='Routes pushed to clients (0.0.0.0/0 = all traffic, else split tunnel)'
  [IKE_PROPOSALS]='IKE (phase 1) proposals the server accepts'
  [ESP_PROPOSALS]='ESP (phase 2) proposals the server accepts'
  [DPD_DELAY]='Dead peer detection interval'
  [FRAGMENTATION]='IKE fragmentation (helps when UDP packets get dropped)'
  [MOBIKE]='MOBIKE: keep the VPN alive when the client changes network (wifi/4G)'
  [UNIQUE]='What to do when a user connects twice (devices per account)'
  [REKEY_TIME]='IKE SA rekey time (empty = strongSwan default)'
  [REAUTH_TIME]='Force full re-authentication after this time (empty = never)'
  [CHILD_REKEY_TIME]='Child SA (ESP) rekey time (empty = strongSwan default)'
  [CHILD_LIFE_TIME]='Child SA (ESP) lifetime (empty = strongSwan default)'
  [SEND_CERT]='When the server sends its certificate'
  [MSS_CLAMP]='TCP MSS clamping for tunnel traffic (fixes slow/stuck pages)'
  [NAT]='NAT (masquerade) VPN traffic out of the server'
  [FW_EXTRA_TCP]='Extra TCP ports to allow inbound when the firewall is on'
  [FW_EXTRA_UDP]='Extra UDP ports to allow inbound when the firewall is on'
  [LOG_LEVEL]='strongSwan log verbosity (journal)'
  [CLIENT_ISOLATION]='Stop VPN clients from reaching each other (device-to-device)'
  [BLOCK_PRIVATE]='Stop VPN clients from reaching private networks (RFC1918/CGNAT) behind the server'
  [IKE_RATE_LIMIT]='Max new IKE handshakes per minute per source IP on UDP/500 (brute-force brake)'
  [IPV6_BLOCK]='Route ::/0 into the tunnel and drop it, so IPv6 cannot leak (experimental)'
  [QUOTA_ACTION]='What happens when a user runs out of traffic or time (a user can override it)'
  [DEFAULT_LIMIT]='Traffic limit given to NEW users (empty = unlimited)'
  [DEFAULT_DAYS]='Validity in days given to NEW users (empty = never expires)'
)
declare -A S_DEF=(
  [DNS]="$D_DNS" [POOL]="$D_POOL" [LOCAL_TS]="$D_LOCAL_TS" [IKE_PROPOSALS]="$D_IKE_PROPOSALS"
  [ESP_PROPOSALS]="$D_ESP_PROPOSALS" [DPD_DELAY]="$D_DPD_DELAY" [FRAGMENTATION]="$D_FRAGMENTATION"
  [MOBIKE]="$D_MOBIKE" [UNIQUE]="$D_UNIQUE" [REKEY_TIME]="" [REAUTH_TIME]="" [CHILD_REKEY_TIME]=""
  [CHILD_LIFE_TIME]="" [SEND_CERT]="$D_SEND_CERT" [MSS_CLAMP]="$D_MSS_CLAMP" [NAT]="$D_NAT"
  [FW_EXTRA_TCP]="" [FW_EXTRA_UDP]="" [LOG_LEVEL]="$D_LOG_LEVEL"
  [CLIENT_ISOLATION]="$D_CLIENT_ISOLATION" [BLOCK_PRIVATE]="$D_BLOCK_PRIVATE"
  [IKE_RATE_LIMIT]="$D_IKE_RATE_LIMIT" [IPV6_BLOCK]="$D_IPV6_BLOCK"
  [QUOTA_ACTION]="$D_QUOTA_ACTION" [DEFAULT_LIMIT]="" [DEFAULT_DAYS]=""
)
declare -A S_HINT=(
  [DNS]='comma-separated IPv4, e.g. 1.1.1.1,8.8.8.8'
  [POOL]='IPv4 CIDR /8../30, e.g. 10.30.0.0/16'
  [LOCAL_TS]='comma-separated CIDRs, e.g. 0.0.0.0/0 or 10.0.0.0/8,192.168.1.0/24'
  [IKE_PROPOSALS]='strongSwan proposal list, e.g. default,aes256-sha256-modp2048'
  [ESP_PROPOSALS]='strongSwan proposal list, e.g. default,aes256gcm16'
  [DPD_DELAY]='number + s/m/h/d, e.g. 30s'
  [FRAGMENTATION]='yes | no | force | accept'
  [MOBIKE]='yes | no'
  [UNIQUE]='no | never | keep | replace  (no = allow several sessions per user)'
  [REKEY_TIME]='e.g. 4h, 1h, 24h'
  [REAUTH_TIME]='e.g. 24h'
  [CHILD_REKEY_TIME]='e.g. 1h'
  [CHILD_LIFE_TIME]='e.g. 1h20m is NOT allowed; use one unit, e.g. 80m'
  [SEND_CERT]='always | ifasked | never'
  [MSS_CLAMP]='pmtu | off | a number 536-1460 (e.g. 1360)'
  [NAT]='yes | no'
  [FW_EXTRA_TCP]='ports, comma or space separated, e.g. 443,8080'
  [FW_EXTRA_UDP]='ports, comma or space separated'
  [LOG_LEVEL]='default | -1 | 0 | 1 | 2 | 3 | 4  (higher = more detail)'
  [CLIENT_ISOLATION]='yes | no   (yes = clients cannot talk to each other)'
  [BLOCK_PRIVATE]='yes | no   (LOCAL_TS routes and the DNS servers stay reachable)'
  [IKE_RATE_LIMIT]='off | a number 10-100000 (new IKE_SA_INIT per minute per IP, e.g. 60)'
  [IPV6_BLOCK]='yes | no   (only has an effect when LOCAL_TS contains 0.0.0.0/0)'
  [QUOTA_ACTION]='disable | delete | notify   (disable = keep the user but block it, notify = only tell the bot)'
  [DEFAULT_LIMIT]='a size such as 500M, 10G, 1.5T (a bare number means GB), or unlimited'
  [DEFAULT_DAYS]='a number of days 1-3650, or never'
)
declare -A S_CHECK=(
  [DNS]=v_dns [POOL]=v_pool [LOCAL_TS]=v_cidr_list [IKE_PROPOSALS]=v_props [ESP_PROPOSALS]=v_props
  [DPD_DELAY]=v_dur1 [FRAGMENTATION]='enum:yes|no|force|accept' [MOBIKE]='enum:yes|no'
  [UNIQUE]='enum:no|never|keep|replace' [REKEY_TIME]=v_dur1 [REAUTH_TIME]=v_dur1
  [CHILD_REKEY_TIME]=v_dur1 [CHILD_LIFE_TIME]=v_dur1 [SEND_CERT]='enum:always|ifasked|never'
  [MSS_CLAMP]=v_mss [NAT]='enum:yes|no' [FW_EXTRA_TCP]=v_ports [FW_EXTRA_UDP]=v_ports
  [LOG_LEVEL]='enum:default|-1|0|1|2|3|4'
  [CLIENT_ISOLATION]='enum:yes|no' [BLOCK_PRIVATE]='enum:yes|no' [IKE_RATE_LIMIT]=v_ratelimit [IPV6_BLOCK]='enum:yes|no'
  [QUOTA_ACTION]='enum:disable|delete|notify' [DEFAULT_LIMIT]=v_size [DEFAULT_DAYS]=v_defdays
)

v_ipv4() {
  local ip="$1" o
  [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for o in "${BASH_REMATCH[@]:1}"; do (( 10#$o <= 255 )) || return 1; done
}
v_cidr() {
  local ip="${1%/*}" p="${1#*/}"
  [[ $1 == */* && $p =~ ^[0-9]{1,2}$ ]] || return 1
  v_ipv4 "$ip" && (( 10#$p <= 32 ))
}
v_dns() { local x a; IFS=, read -ra a <<<"$1"; [[ ${#a[@]} -ge 1 ]] || return 1; for x in "${a[@]}"; do v_ipv4 "$x" || return 1; done; }
v_pool() { v_cidr "$1" && (( 10#${1#*/} >= 8 && 10#${1#*/} <= 30 )); }
v_cidr_list() { local x a; IFS=, read -ra a <<<"$1"; [[ ${#a[@]} -ge 1 ]] || return 1; for x in "${a[@]}"; do v_cidr "$x" || return 1; done; }
v_props() { [[ $1 =~ ^[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*$ ]]; }
v_dur1() { [[ $1 =~ ^[0-9]+[smhd]?$ ]]; }
v_ports() { local p; for p in ${1//,/ }; do [[ $p =~ ^[0-9]+$ ]] && (( 10#$p >= 1 && 10#$p <= 65535 )) || return 1; done; }
v_size() { python3 "$OPT/ikev2lib.py" quota parse-size "$1" >/dev/null 2>&1; }
v_defdays() { [[ $1 == never ]] || { [[ $1 =~ ^[0-9]{1,4}$ ]] && (( 10#$1 <= 3650 )); }; }
v_ratelimit() { [[ $1 == off ]] || { [[ $1 =~ ^[0-9]{2,6}$ ]] && (( 10#$1 >= 10 && 10#$1 <= 100000 )); }; }
v_mss() { [[ $1 =~ ^(pmtu|off)$ ]] || { [[ $1 =~ ^[0-9]{3,4}$ ]] && (( 10#$1 >= 536 && 10#$1 <= 1460 )); }; }

setting_valid() { # key value   (control characters / line breaks are never valid - read() only sees the first line)
  local chk="${S_CHECK[$1]}"
  [[ $2 != *[[:cntrl:]]* ]] || return 1
  case "$chk" in
    enum:*) [[ $2 =~ ^(${chk#enum:})$ ]] ;;
    *)      "$chk" "$2" ;;
  esac
}

setting_known() { [[ -n ${S_DESC[$1]+x} ]]; }

# ---- apply: regenerate everything from config (+ roll back on failure)
settings_apply() {
  local f="$CHARON_D/ikev2-manager.conf" changed=0 new
  mkdir -p "$CHARON_D" "$ETC/custom"
  cfg_load
  new=$(mktemp)
  {
    echo "# Generated by ikev2-manager - use: vpn set LOG_LEVEL ... / vpn raw edit charon"
    if [[ $LOG_LEVEL != default ]]; then
      printf 'charon-systemd {\n  journal {\n    default = %s\n  }\n}\n' "$LOG_LEVEL"
    fi
    if [[ -s $ETC/custom/charon.conf ]]; then cat "$ETC/custom/charon.conf"; fi
  } >"$new"
  if ! cmp -s "$new" "$f" 2>/dev/null; then
    if [[ -f $f ]]; then cp -f "$f" "$f.bak"; else rm -f "$f.bak"; fi
    install -m 644 "$new" "$f"; changed=1
  fi
  rm -f "$new"
  rebuild_conf || return 1
  [[ $TESTMODE == 1 ]] && return 0
  net_apply
  if [[ $changed == 1 ]]; then
    svc_restart; sleep 2
    if [[ $(svc_active) != active ]]; then
      err "strongSwan did not start with the new daemon settings; reverting."
      if [[ -f $f.bak ]]; then cp -f "$f.bak" "$f"; else rm -f "$f"; fi
      svc_restart; return 1
    fi
  fi
  return 0
}

# ---- commands
cmd_get() {
  cfg_load
  local k v def
  if [[ -n ${1:-} ]]; then
    k="${1^^}"; setting_known "$k" || die "Unknown setting '$k'. See: vpn get"
    v="${!k}"; def="${S_DEF[$k]}"
    say "$k = ${v:-(default)}"
    say "  ${S_DESC[$k]}"; say "  accepts: ${S_HINT[$k]}"; say "  default: ${def:-(strongSwan default)}"
    return
  fi
  printf '%-18s %s\n' SETTING VALUE
  for k in "${SETTING_KEYS[@]}"; do
    v="${!k}"; def="${S_DEF[$k]}"
    if [[ $v == "$def" ]]; then v="${v:-(default)}  [default]"; fi
    printf '%-18s %s\n' "$k" "$v"
  done
}

cmd_set() { need_root; locked _set "$@"; }
_set() {
  local k="${1:-}" v="${2-}" oldraw newraw
  k="${k^^}"
  [[ -n $k ]] || die "Usage: vpn set KEY VALUE   (VALUE 'default' resets)  - see: vpn get"
  setting_known "$k" || die "Unknown setting '$k'. See: vpn get"
  cfg_load
  oldraw=$(cfg_raw "$k")
  if [[ -z $v || $v == default ]]; then
    newraw=""
  else
    setting_valid "$k" "$v" || die "Invalid value for $k. Accepts: ${S_HINT[$k]}"
    newraw="$v"
  fi
  cfg_set "$k" "$newraw" || die "Could not save the setting."
  if settings_apply; then
    ok "$k = ${newraw:-default}"
    log "set $k=${newraw:-default}"
    case "$k" in POOL|DNS|LOCAL_TS|IPV6_BLOCK) say "Clients must reconnect to pick this up." ;; esac
  else
    cfg_set "$k" "$oldraw"; settings_apply >/dev/null 2>&1
    die "The server rejected '$v' for $k - the previous value was restored."
  fi
  return 0
}

cmd_reset() {
  need_root
  local yes=0 a ans
  for a in "$@"; do case "$a" in --yes|-y) yes=1 ;; esac; done
  if [[ $yes != 1 ]]; then
    [[ -t 0 ]] || die "This resets ALL advanced settings to their defaults. Re-run with --yes to confirm."
    read -rp "Reset all advanced settings to defaults? [y/N] " ans
    [[ $ans =~ ^[Yy]$ ]] || { say "Cancelled."; return 1; }
  fi
  locked _reset
}
_reset() {
  local k
  for k in "${SETTING_KEYS[@]}"; do cfg_set "$k" "" || return 1; done
  settings_apply && ok "All advanced settings reset to defaults (raw snippets untouched)."
}

DNS_PRESETS="cloudflare google quad9 adguard cloudflare-family opendns"
dns_preset_value() {
  case "$1" in
    cloudflare)        echo "1.1.1.1,1.0.0.1" ;;
    google)            echo "8.8.8.8,8.8.4.4" ;;
    quad9)             echo "9.9.9.9,149.112.112.112" ;;
    adguard)           echo "94.140.14.14,94.140.15.15" ;;
    cloudflare-family) echo "1.1.1.3,1.0.0.3" ;;
    opendns)           echo "208.67.222.222,208.67.220.220" ;;
    *) return 1 ;;
  esac
}

cmd_preset() {
  local kind="${1:-}" name="${2:-}" v
  case "$kind" in
    dns)
      if [[ $name == list || -z $name ]]; then
        for v in $DNS_PRESETS; do printf '  %-18s %s\n' "$v" "$(dns_preset_value "$v")"; done; return
      fi
      v=$(dns_preset_value "$name") || die "Unknown DNS preset. Options: $DNS_PRESETS"
      cmd_set DNS "$v" ;;
    ike)
      case "$name" in
        compat)      cmd_set IKE_PROPOSALS default ;;
        strict-sha2) cmd_set IKE_PROPOSALS 'aes256-sha256-modp2048,aes128-sha256-modp2048,aes256-sha256-ecp256,aes256-sha384-ecp384' ;;
        *) die "Usage: vpn preset ike compat|strict-sha2   (strict-sha2 = explicit SHA-2-only list: no SHA-1 and no built-in 'default' list; old clients may fail)" ;;
      esac ;;
    *) die "Usage: vpn preset dns NAME|list   |   vpn preset ike compat|strict-sha2" ;;
  esac
}

# ---- raw snippets: any strongSwan option can be added through these
RAW_NAMES=(connection local remote child pools extra charon)
declare -A RAW_HELP=(
  [connection]='lines inside  connections { rw { ... } }   (e.g. reauth_time, inactivity ...)'
  [local]='lines inside the server  local { ... }  block'
  [remote]='lines inside the client  remote { ... }  block'
  [child]='lines inside  children { net { ... } }   (e.g. mode, dpd_action ...)'
  [pools]='lines inside  pools { rw_pool { ... } }   (e.g. wins, nbns, dhcp ...)'
  [extra]='whole extra sections appended to swanctl.conf (more connections, authorities, secrets ...)'
  [charon]='raw strongswan.conf fragment for the daemon (e.g. charon { dos_protection = yes })'
)

_raw_apply() { # FILE NAME SUB
  if settings_apply; then
    ok "Applied: $2"; log "raw $3 $2"
  else
    cp -f "$1.prev" "$1"; settings_apply >/dev/null 2>&1
    die "The server rejected this snippet - the previous content was restored."
  fi
}

cmd_raw() {
  local sub="${1:-list}" name="${2:-}" f n ed
  if [[ $sub != list ]]; then
    [[ " ${RAW_NAMES[*]} " == *" $name "* ]] || die "Usage: vpn raw list | show|edit|set|clear NAME   (NAME: ${RAW_NAMES[*]})"
    f="$ETC/custom/$name.conf"
  fi
  case "$sub" in
    list)
      for n in "${RAW_NAMES[@]}"; do
        printf '  %-11s %-8s %s\n' "$n" "$([[ -s $ETC/custom/$n.conf ]] && echo "$(wc -l <"$ETC/custom/$n.conf") lines" || echo empty)" "${RAW_HELP[$n]}"
      done ;;
    show) [[ -s $f ]] && cat "$f" || say "(empty)" ;;
    edit|set|clear)
      need_root
      mkdir -p "$ETC/custom"
      if [[ -f $f ]]; then cp -f "$f" "$f.prev"; else : >"$f.prev"; fi
      case "$sub" in
        edit)
          [[ -t 0 && -t 1 ]] || die "'edit' needs a terminal. Use: vpn raw set $name < file"
          ed="${EDITOR:-}"; [[ -n $ed ]] || ed=$(command -v nano || command -v vi || true)
          [[ -n $ed ]] || die "No editor found (install nano or set EDITOR)."
          [[ -f $f ]] || : >"$f"
          "$ed" "$f" ;;
        set)   cat >"$f" ;;
        clear) : >"$f" ;;
      esac
      locked _raw_apply "$f" "$name" "$sub" ;;
    *) die "Usage: vpn raw list | show|edit|set|clear NAME" ;;
  esac
}

cmd_conf() {
  case "${1:-show}" in
    show)
      sed -E 's/(secret = ").*(")/\1********\2/' "$SWAN/swanctl.conf"
      if [[ -s $CHARON_D/ikev2-manager.conf ]]; then
        echo; echo "# --- $CHARON_D/ikev2-manager.conf"; cat "$CHARON_D/ikev2-manager.conf"
      fi ;;
    apply) need_root; locked settings_apply && ok "Configuration regenerated and applied." ;;
    *) die "Usage: vpn conf show|apply" ;;
  esac
}

# ---- advanced settings menus
tui_presets() {
  local i=1 n ans v
  while true; do
    ui_header "Presets"
    echo; echo " DNS providers:"
    i=1
    for n in $DNS_PRESETS; do ui_item "$i" "$(printf '%-18s %s' "$n" "$(dns_preset_value "$n")")"; i=$((i+1)); done
    echo; echo " IKE strictness:"
    ui_item a "compat       (default; accepts SHA-1 fallbacks)"
    ui_item b "strict-sha2  (SHA-2 only)"
    ui_item 0 "Back"
    ui_choose
    case $CHOICE in
      0|"") return ;;
      a) ui_show "$( (cmd_preset ike compat) 2>&1 )" ;;
      b) ui_show "$( (cmd_preset ike strict-sha2) 2>&1 )" ;;
      *) if [[ $CHOICE =~ ^[0-9]+$ ]]; then
           n=$(echo $DNS_PRESETS | tr ' ' '\n' | sed -n "${CHOICE}p")
           [[ -n $n ]] && ui_show "$( (cmd_preset dns "$n") 2>&1 )"
         fi ;;
    esac
  done
}

tui_raw() {
  local i n
  while true; do
    ui_header "Raw config snippets"
    echo; echo " Add ANY strongSwan option here. It is validated by loading it;"
    echo " if the server rejects it, the previous content is restored."; echo
    i=1
    for n in "${RAW_NAMES[@]}"; do
      ui_item "$i" "$(printf '%-11s %s' "$n" "$([[ -s $ETC/custom/$n.conf ]] && echo '(has content)' || echo '(empty)')")"
      echo "        $(c 2)${RAW_HELP[$n]}$(c 0)"
      i=$((i+1))
    done
    ui_item 0 "Back"
    ui_choose
    case $CHOICE in
      0|"") return ;;
