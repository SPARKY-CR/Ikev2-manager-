# ------------------------------------------------------------ help / main
cmd_help() {
  cat <<EOF
IKEv2 Manager v$VERSION  -  run 'sudo vpn' for the text menu

Users
  vpn user list | add NAME [PASS] | del NAME | enable NAME | disable NAME
  vpn user passwd NAME [PASS] | show NAME
  vpn profile NAME [DIR]       write .sswan / .mobileconfig / windows script
  vpn zed NAME [--nopw]        ZedSecure import link (zedsecure://...)
  vpn ca                       print CA certificate (IP mode)
Server
  vpn status | online | restart | logs [N]
  vpn cert info|renew|auto     vpn domain set DOMAIN [EMAIL] | unset
  vpn ip refresh               vpn upgrade-strongswan
Advanced strongSwan settings
  vpn get [KEY]                list settings (DNS, pool, routes, proposals, timers, ...)
  vpn set KEY VALUE            change one (VALUE "default" resets), applied + validated
  vpn preset dns cloudflare|google|quad9|adguard|cloudflare-family|opendns|list
  vpn preset ike compat|strict-sha2     vpn reset
  vpn raw list|show|edit|set|clear NAME  add ANY strongSwan option (connection, local,
                               remote, child, pools, extra, charon)
  vpn conf show|apply          view / regenerate the final swanctl.conf
Security
  vpn fw on|off|status|ports "22 2222"     vpn security fail2ban|autoupdate
Bot
  vpn bot setup TOKEN ADMIN_ID | on | off | status | test | logs
Maintenance
  vpn backup | backups | restore FILE
  vpn update [--check] [--yes] [--force]     update from the GitHub source
  vpn update --base RAW_URL --save-only      set the update source
  vpn update FOLDER|install.sh               update from a local repo folder / file
  vpn uninstall [--purge] [--yes]
  vpn version
EOF
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    "")                 tui_main ;;
    help|-h|--help)     cmd_help ;;
    version|-v|--version) say "ikev2-manager $VERSION" ;;
    status)             cmd_status "$@" ;;
    online)             cmd_online ;;
    user)               cmd_user "$@" ;;
    profile)            cmd_profile "$@" ;;
    ca)                 cmd_ca ;;
    zed)                cmd_zed "$@" ;;
    restart)            cmd_restart ;;
    logs)               cmd_logs "$@" ;;
    cert)               cmd_cert "$@" ;;
    domain)             cmd_domain "$@" ;;
    ip)                 cmd_ip "$@" ;;
    upgrade-strongswan) cmd_upgrade_strongswan ;;
    fw)                 cmd_fw "$@" ;;
    security)           cmd_security "$@" ;;
    bot)                cmd_bot "$@" ;;
    backup)             cmd_backup ;;
    backups)            cmd_backups ;;
    restore)            cmd_restore "$@" ;;
    update)             cmd_update "$@" ;;
    get)                cmd_get "$@" ;;
    set)                cmd_set "$@" ;;
    reset)              cmd_reset ;;
    preset)             cmd_preset "$@" ;;
    raw)                cmd_raw "$@" ;;
    conf)               cmd_conf "$@" ;;
    uninstall)          cmd_uninstall "$@" ;;
    net)                [[ ${1:-} == apply ]] && net_apply || die "Usage: vpn net apply" ;;
    setup)              cmd_setup "$@" ;;
    migrate)            cmd_migrate ;;
    selftest)           cmd_selftest ;;
    *) err "Unknown command: $cmd"; cmd_help; exit 1 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
