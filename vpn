# ------------------------------------------------------------ setup (used by the installer)
cmd_setup() { need_root; locked _setup "$@"; }
_setup() {
  local mode=ip domain="" email="" user="user1" pass="" fw=no f2b=no au=no tok="" aid="" ip="" ub=""
  # secrets handed over by install.sh travel in the environment (not visible in `ps`), never in argv
  pass="${IKEV2_SETUP_PASS:-}"; tok="${IKEV2_SETUP_BOT_TOKEN:-}"; unset IKEV2_SETUP_PASS IKEV2_SETUP_BOT_TOKEN
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode)       mode="$2"; shift 2 ;;
      --domain)     domain="$2"; mode=domain; shift 2 ;;
      --email)      email="$2"; shift 2 ;;
      --user)       user="$2"; shift 2 ;;
      --pass)       pass="$2"; shift 2 ;;
      --ip)         ip="$2"; shift 2 ;;
      --firewall)   fw="$2"; shift 2 ;;
      --fail2ban)   f2b="$2"; shift 2 ;;
      --autoupdate) au="$2"; shift 2 ;;
      --bot-token)  tok="$2"; shift 2 ;;
      --admin-id)   aid="$2"; shift 2 ;;
      --update-base) ub="$2"; shift 2 ;;
      *) die "setup: unknown option $1" ;;
    esac
  done
  [[ $mode == ip || $mode == domain ]] || die "setup: --mode must be ip or domain"
  [[ $mode == domain && -z $domain ]] && die "Domain mode needs --domain"
  [[ -z $domain || $domain =~ $DOMAIN_RE ]] || die "Invalid domain name: $domain"
  [[ -z $email  || $email  =~ $EMAIL_RE  ]] || die "Invalid email address."
  [[ -z $ip     ]] || v_ipv4 "$ip" || die "Invalid --ip (expected an IPv4 address)."
  [[ $fw == yes || $fw == no ]] || die "setup: --firewall must be yes or no"
  [[ $f2b == yes || $f2b == no ]] || die "setup: --fail2ban must be yes or no"
  [[ $au == yes || $au == no ]] || die "setup: --autoupdate must be yes or no"
  [[ $user =~ $NAME_RE ]] || die "Invalid username"
  [[ -z $pass ]] || pass_check "$user" "$pass" || die "$PASS_ERR"
  [[ -z $tok || $tok =~ $TOKEN_RE ]] || die "That does not look like a Telegram bot token."
  [[ -z $aid || $aid =~ ^[0-9]+$ ]] || die "--admin-id must be numeric."
  [[ -z $ub  ]] || update_base_ok "$ub" || die "--update-base must be an https:// (or file://) URL."
  [[ -z $ub  ]] || cfg_set UPDATE_BASE "$ub"

  mkdir -p "$ETC" "$VAR" "$BACKUPS"; chmod 700 "$ETC" "$BACKUPS"; : >>"$LOGFILE"

  step "Installing packages (this can take a minute)"
  export DEBIAN_FRONTEND=noninteractive
  [[ $TESTMODE == 1 ]] || apt-get update >>"$LOGFILE" 2>&1 || warn "apt-get update reported errors (see $LOGFILE)"
  apt_install strongswan strongswan-swanctl strongswan-pki charon-systemd \
    libcharon-extra-plugins libcharon-extauth-plugins iptables curl openssl python3 ca-certificates
  [[ $TESTMODE == 1 ]] || systemctl disable --now strongswan-starter >/dev/null 2>&1 || true

  step "Detecting server address"
  [[ -n $ip ]] || ip=$(detect_public_ip) || die "Could not detect the public IP. Re-run with --ip SERVER_IP"
  cfg_set SERVER_IP "$ip"; cfg_set IFACE "$(default_iface)"
  say "  Public IP: $ip   Interface: $(default_iface)"

  # keep a copy of any pre-existing manual config, then clear it
  if [[ -f $SWAN/swanctl.conf ]] && ! grep -q 'ikev2-manager' "$SWAN/swanctl.conf"; then
    local old="$BACKUPS/pre-install-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$old"; cp -a "$SWAN" "$old/" 2>/dev/null || true
    say "  Existing strongSwan config backed up to $old"
    rm -f "$SWAN"/x509/* "$SWAN"/x509ca/* "$SWAN"/private/* "$SWAN/swanctl.conf" 2>/dev/null || true
  fi

  if [[ $mode == domain ]]; then mode_setup_domain "$domain" "$email"; else mode_setup_ip "$ip"; fi

  step "Creating first user"
  users_ensure
  if user_exists "$user"; then pass=$(user_get "$user" 2); else
    [[ -n $pass ]] || pass=$(gen_strong_pass "$user")
    printf '%s:%s:enabled:%s\n' "$user" "$pass" "$(date +%s)" >>"$USERS"
  fi

  step "Configuring services"
  install_units
  if [[ $TESTMODE != 1 ]]; then
    systemctl enable "$(svc_name)" >/dev/null 2>&1 || true
    systemctl restart "$(svc_name)" || warn "Could not start $(svc_name)"
    sleep 2
  fi
  rebuild_conf || die "Could not load VPN configuration (see: vpn logs)"
  cfg_set FIREWALL "$fw"
  if [[ $fw == yes ]]; then cfg_set FW_SSH_PORTS "$(fw_ssh_ports)"; fi
  if [[ $TESTMODE != 1 ]]; then
    systemctl enable ikev2-net >/dev/null 2>&1 || true
    net_apply
    systemctl enable --now ikev2-certcheck.timer >/dev/null 2>&1 || true
    systemctl enable --now ikev2-quota.timer >/dev/null 2>&1 || true
  fi
  [[ $f2b == yes ]] && sec_fail2ban
  [[ $au == yes ]]  && sec_autoupdate
  if [[ -n $tok && -n $aid ]]; then printf '%s\n' "$tok" | cmd_bot setup - "$aid" || warn "Bot setup failed; run 'vpn bot setup' later."; fi

  local healthy="no"
  if [[ $TESTMODE == 1 ]] || { [[ $(svc_active) == active ]] && run_swanctl --list-conns 2>/dev/null | grep -q '^rw:'; }; then healthy=yes; fi

  say
  ok "================ INSTALL COMPLETE ================"
  say " Server address : $(grep "^SERVER_NAME=" "$CONF" | cut -d"'" -f2)"
  say " Username       : $user"
  say " Password       : $pass"
  say " Health check   : $healthy"
  say " Manage         : sudo vpn   (text menu)"
  [[ $mode == ip ]] && say " Client trust   : use 'vpn profile $user' (CA is embedded in the profiles)"
  say
  warn "Open UDP 500 and UDP 4500 (and TCP 80 for domain mode) in your cloud firewall / Security Group."
  [[ $healthy == yes ]] || warn "VPN did not pass the health check. Run: sudo vpn logs"
}

# ------------------------------------------------------------ migrate / selftest / update
cmd_migrate() { locked _migrate; }
_migrate() {
  [[ -f $CONF ]] || return 0
  cfg_load; users_ensure
  mkdir -p "$VAR" "$BACKUPS"; chmod 700 "$BACKUPS" 2>/dev/null
  install_units
  [[ -n $SERVER_NAME ]] && rebuild_conf
  [[ $TESTMODE == 1 ]] || { _net_apply; systemctl enable --now ikev2-quota.timer >/dev/null 2>&1 || true; }
  return 0
}

cmd_selftest() {
  local rc=0 cmd
  bash -n "$SELF" 2>/dev/null || { err "vpn script has syntax errors"; rc=1; }
  python3 -m py_compile "$OPT/bot.py" "$OPT/ikev2lib.py" 2>/dev/null || { err "python files do not compile"; rc=1; }
  # run real commands and fail on shell runtime errors written to stderr
  local out
  for cmd in "version" "get" "status --kv" "user list"; do
    out=$("$SELF" $cmd 2>&1 >/dev/null) || true
    if grep -Eq 'command not found|unbound variable|syntax error|bad substitution' <<<"$out"; then
      err "runtime error in 'vpn $cmd': $(head -1 <<<"$out")"; rc=1
    fi
  done
  if [[ -f $CONF ]]; then
    local bad
    bad=$(grep -cvE "^[A-Z][A-Z0-9_]*='.*'$|^$" "$CONF")
    [[ $bad -eq 0 ]] || { err "config.env has $bad unparsable line(s)"; rc=1; }
    [[ $TESTMODE == 1 ]] || { [[ $(svc_active) == active ]] || { err "VPN service is not active"; rc=1; }; }
  fi
  return $rc
}

version_older() { # $1 older than $2 ?
  [[ $1 != "$2" && $(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1) == "$1" ]]
}

# --- release download + verification -------------------------------------------------------------
# An update is downloaded into a private folder, verified (SHA256SUMS, and a signature when a
# release key is pinned in /etc/ikev2/release.pub) and only THEN executed. Nothing that has not
# been verified is ever run as root.
REL_FILES=(install.sh vpn bot.py ikev2lib.py VERSION)
VERSION_RE='^[0-9]+(\.[0-9]+)*([-.][A-Za-z0-9]+)*$'

update_base_ok() { [[ $1 =~ ^(https://|file://)[A-Za-z0-9._~:/?#@%+=\&,-]+$ ]]; }

curl_get() { # URL : https or file only; a redirect may never downgrade to http
  case "$1" in
    https://*) curl -fsSL --max-time 60 --proto '=https' --proto-redir '=https' "$1" ;;
    file://*)  curl -fsSL --max-time 60 --proto '=file' "$1" ;;
    *) err "refusing to fetch $1 (only https:// and file:// are allowed)"; return 1 ;;
  esac
}

release_fetch() { # BASE DIR
  local base="$1" d="$2" f
  for f in "${REL_FILES[@]}" SHA256SUMS; do
    curl_get "$base/$f" >"$d/$f" 2>/dev/null || { err "could not download $base/$f"; return 1; }
  done
  for f in release.pub SHA256SUMS.sig; do curl_get "$base/$f" >"$d/$f" 2>/dev/null || rm -f "$d/$f"; done
  return 0
}

release_verify() { # DIR
  local d="$1" f exp got key=""
  [[ -s $d/SHA256SUMS ]] || { err "SHA256SUMS is missing"; return 1; }
  for f in "${REL_FILES[@]}" $([[ -f $d/release.pub ]] && echo release.pub); do
    exp=$(awk -v f="$f" '{n=$2; sub(/^\*/,"",n)} n==f{print $1; exit}' "$d/SHA256SUMS")
    [[ $exp =~ ^[0-9a-f]{64}$ ]] || { err "$f is not listed in SHA256SUMS"; return 1; }
    got=$(sha256sum "$d/$f" 2>/dev/null | cut -d' ' -f1)
    [[ $got == "$exp" ]] || { err "checksum mismatch for $f - corrupted or tampered download"; return 1; }
  done
  if [[ -f $RELEASE_PUB ]]; then key="$RELEASE_PUB"                                   # pinned: signature is mandatory
  elif [[ -f $d/release.pub && -f $d/SHA256SUMS.sig ]]; then key="$d/release.pub"     # first signed release (trust on first use)
  fi
  if [[ -n $key ]]; then
    [[ -s $d/SHA256SUMS.sig ]] || { err "this release is not signed, but a release key is pinned in $RELEASE_PUB - refusing"; return 1; }
    if ! { base64 -d <"$d/SHA256SUMS.sig" >"$d/.sig.bin" 2>/dev/null &&
           openssl dgst -sha256 -verify "$key" -signature "$d/.sig.bin" "$d/SHA256SUMS" >/dev/null 2>&1; }; then
      rm -f "$d/.sig.bin"; err "signature verification FAILED - refusing to install"; return 1
    fi
    rm -f "$d/.sig.bin"; ok "Signature OK"
  else
    warn "This release is not signed (no release key pinned yet): only checksums were verified."
  fi
  return 0
}

cmd_update() {
  need_root
  local src="" force=0 yes=0 check=0 notify=0 saveonly=0 base="" a latest new cur d rc flags=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;; --yes|-y) yes=1 ;; --check) check=1 ;; --notify) notify=1 ;;
      --save-only) saveonly=1 ;;
      --base) base="${2:-}"; shift ;;
      *) src="$1" ;;
    esac
    shift
  done
  cfg_load
  if [[ -n $base ]]; then
    update_base_ok "$base" || die "Invalid update source. Only https:// (or file://) URLs are accepted - plain http:// would let anyone on the network replace the update."
    base="${base%/}"; cfg_set UPDATE_BASE "$base"; UPDATE_BASE="$base"; ok "Update source saved: $base"
    [[ $saveonly == 1 ]] && return 0
  fi
  [[ $notify == 1 ]] && flags+=(--notify)
  cur="$VERSION"

  # --- local folder (cloned repo): the admin chose this code, so it is trusted as-is
  if [[ -n $src ]]; then
    [[ -d $src ]] || die "Give a cloned repo folder. (Updating from an installer file/URL was removed: it executed unverified code as root. For a remote source use: vpn update --base https://...)"
    [[ -f $src/install.sh && -f $src/vpn && -f $src/VERSION ]] || die "$src is not an ikev2-manager repo folder."
    new=$(tr -d '[:space:]' <"$src/VERSION")
    say "Installed: $cur   Folder: $new"
    if [[ $yes == 0 ]]; then read -rp "Install this version? [y/N] " a; [[ $a == y || $a == Y ]] || die "Cancelled."; fi
    bash "$src/install.sh" --upgrade --from "$src" "${flags[@]}"; return $?
  fi

  # --- remote update
  [[ -n ${UPDATE_BASE:-} ]] || die "No update source configured. Run: vpn update --base $D_UPDATE_BASE --save-only"
  update_base_ok "$UPDATE_BASE" || die "Refusing to update from an insecure source ($UPDATE_BASE). Use: vpn update --base https://..."
  latest=$(curl_get "$UPDATE_BASE/VERSION" 2>/dev/null | tr -d '[:space:]') || die "Could not reach $UPDATE_BASE/VERSION"
  [[ $latest =~ $VERSION_RE ]] || die "Remote VERSION file is not valid: '$latest'"
  if [[ $check == 1 ]]; then      # informational only (unverified); installing always verifies
    printf 'installed=%s\nlatest=%s\n' "$cur" "$latest"
    if version_older "$cur" "$latest"; then say "Update available: $cur -> $latest  (run: sudo vpn update)"
    elif [[ $cur == "$latest" ]]; then say "Up to date."
    else say "Installed version ($cur) is newer than the source ($latest)."; fi
    return 0
  fi
  say "Installed version: $cur"; say "Latest version:    $latest"
  if [[ $latest == "$cur" && $force == 0 ]]; then ok "Already up to date (use --force to reinstall)."; return 0; fi

  d=$(mktemp -d "${TMPDIR:-/tmp}/ikev2-update.XXXXXX") || die "mktemp failed"; chmod 700 "$d"
  say "Downloading and verifying the release..."
  if ! release_fetch "$UPDATE_BASE" "$d"; then rm -rf "$d"; die "Download failed - nothing was changed."; fi
  if ! release_verify "$d"; then rm -rf "$d"; die "Verification FAILED - nothing was installed."; fi
  new=$(tr -d '[:space:]' <"$d/VERSION")
  [[ $new =~ $VERSION_RE ]] || { rm -rf "$d"; die "The release VERSION file is not valid."; }
  if [[ $new == "$cur" && $force == 0 ]]; then rm -rf "$d"; ok "Already up to date (use --force to reinstall)."; return 0; fi
  if version_older "$new" "$cur" && [[ $force == 0 ]]; then rm -rf "$d"; die "The release ($new) is older than the installed version. Use --force to downgrade."; fi
  if [[ $yes == 0 ]]; then
    read -rp "Verified release $new. Install it now? Users, certificates and settings are kept. [y/N] " a
    [[ $a == y || $a == Y ]] || { rm -rf "$d"; die "Cancelled."; }
  fi
  bash "$d/install.sh" --upgrade --from "$d" --verified "${flags[@]}"; rc=$?
  rm -rf "$d"; return $rc
}

# ------------------------------------------------------------ uninstall
cmd_uninstall() {
  need_root
  local purge=0 yes=0 a ans
  for a in "$@"; do case "$a" in --purge) purge=1 ;; --yes) yes=1 ;; esac; done
  if [[ $yes == 0 ]]; then
    warn "This removes the VPN manager, bot, firewall rules and VPN configuration."
    [[ $purge == 1 ]] && warn "--purge also removes strongSwan packages and ALL data in $ETC (users, CA, keys)."
    read -rp "Type YES to continue: " ans
    [[ $ans == YES ]] || die "Aborted."
  fi
  step "Creating a final backup"
  cmd_backup || true
  step "Stopping services"
  systemctl disable --now ikev2-bot ikev2-certcheck.timer ikev2-quota.timer ikev2-net >/dev/null 2>&1 || true
  net_clear
  rm -f "$UNIT_DIR"/ikev2-{net,bot,certcheck,quota}.service "$UNIT_DIR/ikev2-certcheck.timer" "$UNIT_DIR/ikev2-quota.timer"
  systemctl daemon-reload
  rm -f "$SWAN/swanctl.conf" "$SWAN/swanctl.conf.bak" "$SWAN/x509/server.pem" "$SWAN/x509ca/ikev2-ca.pem" \
        "$SWAN/private/server.key" "$SWAN/x509ica/le-chain.pem" "$SYSCTL_D/99-ikev2.conf" "$CHARON_D/ikev2-manager.conf"
  if [[ $purge == 1 ]]; then
    step "Removing packages and data"
    systemctl disable --now "$(svc_name)" >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get purge -y strongswan strongswan-swanctl strongswan-pki charon-systemd \
      libcharon-extra-plugins libcharon-extauth-plugins >>"$LOGFILE" 2>&1 || true
    rm -rf "$ETC" "$VAR" "$EXPORTS"     # $EXPORTS holds client profiles that contain passwords
    rm -f "$LOGFILE"
  else
    svc_restart 2>/dev/null || true
    [[ -d $EXPORTS ]] && warn "Client profiles (they contain passwords) remain in $EXPORTS - delete them if you no longer need them."
  fi
  rm -rf "$OPT"
  ok "Uninstalled. Final backup is in $BACKUPS"
  rm -f "$BIN_PATH"
}

# ------------------------------------------------------------ text UI (plain numbered menus, no extra packages)
ui_tty()   { [[ -t 0 && -t 1 ]]; }
ui_clear() { if ui_tty; then printf '\033[H\033[2J\033[3J'; fi; return 0; }
ui_pause() { local _; read -rp " Press Enter to continue... " _ || true; }

ui_header() { # title
  ui_clear
  local w=42 line
  line=$(printf '═%.0s' $(seq 1 $w))
  printf '%s ╔%s╗\n ║ %-*s ║\n ╚%s╝%s\n' "$(c '1;36')" "$line" $((w-2)) "$1" "$line" "$(c 0)"
}

ui_item() { printf '  %s%s)%s %s\n' "$(c '1;33')" "$1" "$(c 0)" "$2"; }

ui_choose() { # sets CHOICE
  local ans
  printf '\n'
  if ! read -rp " Select: " ans; then CHOICE=0; echo; return; fi
  CHOICE="${ans//[[:space:]]/}"
}

ui_ask() { # prompt [default]  -> prints value
  local v
  read -rp " $1${2:+ [$2]}: " v || v=""
  printf '%s' "${v:-${2:-}}"
}

ui_yesno() { # prompt [default y|n] -> 0 = yes
  local d="${2:-n}" a
  read -rp " $1 [$([[ $d == y ]] && echo Y/n || echo y/N)] " a || a=""
  a="${a:-$d}"
  [[ $a == y || $a == Y ]]
}

ui_run() { echo; ( "$@" ); local rc=$?; echo; [[ $rc -eq 0 ]] || warn "(finished with errors)"; ui_pause; }

ui_show() { echo; printf '%s\n' "$1"; echo; ui_pause; }

ui_dash() {
  cfg_load
  local svc users on dot
  svc=$(svc_active); users=$(user_count)
  on=$(python3 "$OPT/ikev2lib.py" count 2>/dev/null || echo 0)
  if [[ $svc == active ]]; then dot="$(c 32)● running$(c 0)"; else dot="$(c 31)● ${svc:-unknown}$(c 0)"; fi
  printf ' Server : %s (%s mode)\n Service: %s\n Users  : %s     Online now: %s\n' "$SERVER_NAME" "$MODE" "$dot" "$users" "$on"
}

ui_pick_user() { # sets PICKED
  PICKED=""
  local lines=() i=1 n s l ans
  while IFS='|' read -r n s _; do lines+=("$n|$s"); done < <(cmd_user_list --plain)
  if [[ ${#lines[@]} -eq 0 ]]; then warn " No users yet."; ui_pause; return 1; fi
  echo
  for l in "${lines[@]}"; do ui_item "$i" "${l%%|*}  $(c 2)(${l##*|})$(c 0)"; i=$((i+1)); done
  ui_item 0 "Cancel"
  read -rp " Select user: " ans || return 1
  [[ $ans =~ ^[0-9]+$ && $ans -ge 1 && $ans -le ${#lines[@]} ]] || return 1
  PICKED="${lines[$((ans-1))]%%|*}"
}

# ---- users
tui_profile() { # name
  local name="$1" dir out
  while true; do
    ui_header "Profile: $name"
    echo
    ui_item 1 "Show connection info (server / user / password)"
    ui_item 2 "Export profile files (Android, iPhone, Windows)"
    ui_item 3 "Show CA certificate text (to copy by hand)"
    ui_item 4 "Show ZedSecure import link"
    ui_item 0 "Back"
    ui_choose
    case $CHOICE in
      1) ui_show "$( (cmd_user_show "$name") 2>&1 )" ;;
      2) dir="$EXPORTS/$name"
         if out=$( (profile_make "$name" "$dir") 2>&1 ); then
           ui_show "Saved in: $dir
$(ls -1 "$dir")

Download them from your computer, for example:
  scp -i KEY.pem USER@$SERVER_NAME:$dir/* .
Or just use the Telegram bot: it sends the files directly."
         else ui_show "$out"; fi ;;
      3) ui_show "$( (cmd_ca) 2>&1 )" ;;
      4) ui_show "Copy the whole link and import it from the clipboard in ZedSecure:

$( (cmd_zed "$name") 2>&1 )

(Without password: vpn zed $name --nopw)" ;;
      0|"") return ;;
    esac
  done
}

tui_users() {
  local name pass out
  while true; do
    ui_header "Users & profiles"
    echo; cmd_user_list; echo
    ui_item 1 "Add user"
    ui_item 2 "Profile / connection info"
    ui_item 3 "Enable or disable a user"
    ui_item 4 "Change password"
    ui_item 5 "Delete user"
    ui_item 6 "Traffic limit & expiry"
    ui_item 0 "Back"
    ui_choose
    case $CHOICE in
      6) tui_quota ;;
      1) echo; name=$(ui_ask "New username (letters, digits, _ . -)"); echo
         [[ -n $name ]] || continue
         pass=$(ui_ask "Password (Enter = random)"); echo
         out=$( cmd_user_add "$name" ${pass:+"$pass"} 2>&1 ); ui_show "$out" ;;
      2) ui_pick_user && tui_profile "$PICKED" ;;
      3) ui_pick_user || continue
         if [[ $(user_get "$PICKED" 3) == enabled ]]; then out=$( cmd_user_setstatus "$PICKED" disabled 2>&1 )
         else out=$( cmd_user_setstatus "$PICKED" enabled 2>&1 ); fi
         ui_show "$out" ;;
      4) ui_pick_user || continue
         echo; pass=$(ui_ask "New password (Enter = random)"); echo
         out=$( cmd_user_passwd "$PICKED" ${pass:+"$pass"} 2>&1 ); ui_show "$out" ;;
      5) ui_pick_user || continue
         echo
         if ui_yesno "Delete '$PICKED'? This cannot be undone." n; then
           out=$( cmd_user_del "$PICKED" 2>&1 ); ui_show "$out"
         fi ;;
      0|"") return ;;
    esac
  done
}

# ---- traffic limit & expiry
tui_quota() {
  local out lim days act
  while true; do
    ui_header "Traffic limit & expiry"
    echo; qpy list; echo
    ui_item 1 "Set limit / expiry / action for a user"
    ui_item 2 "Add traffic or days (renew)"
    ui_item 3 "Reset usage to 0"
    ui_item 4 "Defaults for new users and what happens when over"
    ui_item 0 "Back"
    ui_choose
    case $CHOICE in
      1) ui_pick_user || continue
         echo; lim=$(ui_ask "Traffic limit (e.g. 10G, unlimited; Enter = keep)")
         days=$(ui_ask "Valid for how many days from now, a date YYYY-MM-DD, or never (Enter = keep)")
         act=$(ui_ask "When over: default, disable, delete or notify (Enter = keep)"); echo
         local args=()
         [[ -n $lim ]] && args+=(--limit "$lim")
         [[ -n $days ]] && args+=(--expires "$days")
         [[ -n $act ]] && args+=(--action "$act")
         if [[ ${#args[@]} -eq 0 ]]; then continue; fi
         out=$( cmd_quota set "$PICKED" "${args[@]}" 2>&1 ); ui_show "$out" ;;
      2) ui_pick_user || continue
         echo; lim=$(ui_ask "Add traffic (e.g. 5G; Enter = none)")
         days=$(ui_ask "Add days (e.g. 30; Enter = none)"); echo
         local args=()
         [[ -n $lim ]] && args+=(--limit "$lim")
         [[ -n $days ]] && args+=(--days "$days")
         if [[ ${#args[@]} -eq 0 ]]; then continue; fi
         out=$( cmd_quota add "$PICKED" "${args[@]}" 2>&1 ); ui_show "$out" ;;
      3) ui_pick_user || continue
         out=$( cmd_quota reset "$PICKED" 2>&1 ); ui_show "$out" ;;
      4) cfg_load; echo
         lim=$(ui_ask "Default traffic limit for new users (e.g. 20G, unlimited)" "${DEFAULT_LIMIT:-unlimited}")
         days=$(ui_ask "Default validity in days for new users (number or never)" "${DEFAULT_DAYS:-never}")
         act=$(ui_ask "When a user runs out (disable, delete, notify)" "$QUOTA_ACTION"); echo
         out=$( { [[ $lim == unlimited ]] && lim=default; [[ $days == never ]] && days=default
                  cmd_set DEFAULT_LIMIT "$lim"; cmd_set DEFAULT_DAYS "$days"; cmd_set QUOTA_ACTION "$act"; } 2>&1 )
         ui_show "$out" ;;
      0|"") return ;;
    esac
  done
}

