    ui_item 5 "Telegram bot"
    ui_item 6 "Security (firewall, fail2ban, auto-updates)"
    ui_item 7 "Backup & restore"
    ui_item 8 "Updates"
    ui_item 9 "Uninstall"
    ui_item 0 "Exit"
    ui_choose
    case $CHOICE in
      1) tui_users ;;
      2) tui_status ;;
      3) tui_server ;;
      4) tui_advanced ;;
      5) tui_bot ;;
      6) tui_security ;;
      7) tui_backup ;;
