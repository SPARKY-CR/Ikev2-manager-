# profile_make NAME DIR
# Files are created 0600 from the start (umask) and ONLY the files written here are touched,
# so pointing DIR at an existing folder never changes the permissions of unrelated files.
profile_make() {
  local name="$1" dir="$2" pass f
  cfg_load
  [[ -n $SERVER_NAME ]] || die "Server is not configured."
  user_exists "$name" || die "No such user: $name"
  pass=$(user_get "$name" 2)
  [[ -d $dir ]] || install -d -m 700 "$dir" || die "Cannot create $dir"
  (
    umask 077
    gen_sswan "$name" >"$dir/$name.sswan" &&
    gen_mobileconfig "$name" "$pass" >"$dir/$name.mobileconfig" &&
    gen_windows_ps1 "$name" >"$dir/$name-windows.ps1" &&
    gen_zed_file "$name" "$pass" >"$dir/zedsecure-$name.txt" &&
    gen_readme "$name" "$pass" >"$dir/README-$name.txt" &&
    { [[ $MODE != ip ]] || cp -f "$PKI/ca.pem" "$dir/ca.crt"; }
  ) || die "Could not write the profile files to $dir"
  for f in "$name.sswan" "$name.mobileconfig" "$name-windows.ps1" "zedsecure-$name.txt" "README-$name.txt" ca.crt; do
    [[ -f $dir/$f ]] && chmod 600 "$dir/$f"
  done
  return 0
}

cmd_profile() {
  local name="${1:-}" dir="${2:-}"
  [[ -n $name ]] || die "Usage: vpn profile NAME [OUTPUT_DIR]"
  [[ -n $dir ]] || dir="$EXPORTS/$name"
