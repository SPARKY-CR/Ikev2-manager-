# ---- backup
tui_backup() {
  local items=() x i ans
  while true; do
    ui_header "Backup & restore"
    echo; echo " Folder: $BACKUPS"; echo
    ui_item 1 "Create backup now (local, root-only)"
    ui_item 2 "Create ENCRYPTED backup (safe to copy off the server)"
    ui_item 3 "Backup encryption key (status / create)"
    ui_item 4 "List backups"
    ui_item 5 "Restore a backup"
    ui_item 0 "Back"
    ui_choose
    case $CHOICE in
      1) ui_run cmd_backup ;;
      2) ui_run cmd_backup --encrypt ;;
      3) echo; cmd_backup key show; echo
         if [[ ! -f $BACKUP_PUB ]] && ui_yesno "Create a key pair now? (the private key is shown ONCE - you must save it)" n; then ui_run cmd_backup key init
         else ui_pause; fi ;;
      4) ui_show "$(cmd_backups || true)" ;;
      5) items=(); while read -r x; do [[ -n $x ]] && items+=("$x"); done < <(cmd_backups)
         if [[ ${#items[@]} -eq 0 ]]; then warn " No backups found."; ui_pause; continue; fi
         echo; i=1; for x in "${items[@]}"; do ui_item "$i" "$(basename "$x")"; i=$((i+1)); done; ui_item 0 "Cancel"
         read -rp " Select backup: " ans || continue
         [[ $ans =~ ^[0-9]+$ && $ans -ge 1 && $ans -le ${#items[@]} ]] || continue
         echo; if ui_yesno "Restore $(basename "${items[$((ans-1))]}")? Current users/certs are overwritten (a safety copy is made first)." n; then
           if [[ ${items[$((ans-1))]} == *.enc ]]; then
             x=$(ui_ask "Path to your backup PRIVATE key"); echo
             [[ -n $x ]] && ui_run cmd_restore "${items[$((ans-1))]}" --key "$x"
           else
             ui_run cmd_restore "${items[$((ans-1))]}"
           fi
         fi ;;
      0|"") return ;;
    esac
  done
}

