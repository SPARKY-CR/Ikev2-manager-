# ------------------------------------------------------------ advanced settings
CHARON_D="${IKEV2_STRONGSWAND:-/etc/strongswan.d}"

SETTING_KEYS=(DNS POOL LOCAL_TS IKE_PROPOSALS ESP_PROPOSALS DPD_DELAY FRAGMENTATION MOBIKE UNIQUE
  REKEY_TIME REAUTH_TIME CHILD_REKEY_TIME CHILD_LIFE_TIME SEND_CERT MSS_CLAMP NAT
  FW_EXTRA_TCP FW_EXTRA_UDP LOG_LEVEL)

declare -A S_DESC=(
  [DNS]='DNS servers pushed to clients'
  [POOL]='Virtual IP range handed to clients'
  [LOCAL_TS]='Routes pushed to clients (0.0.0.0/0 = all traffic, else split tunnel)'
  [IKE_PROPOSALS]='IKE (phase 1) proposals the server accepts'
  [ESP_PROPOSALS]='ESP (phase 2) proposals the server accepts'
  [DPD_DELAY]='Dead peer detection interval'
  [FRAGMENTATION]='IKE fragmentation (helps when UDP packets get dropped)'
  [MOBIKE]='MOBIKE: keep the VPN alive when the client changes network (wifi/4G)'
  [UNIQUE]='What to do when a user connects twice (devices per account)'
  [REKEY_TIME]='IKE SA rekey time (empty = strongSwan default)'
  [REAUTH_TIME]='Force full re-authentication after this time (empty = never)'
  [CHILD_REKEY_TIME]='Child SA (ESP) rekey time (empty = strongSwan default)'
  [CHILD_LIFE_TIME]='Child SA (ESP) lifetime (empty = strongSwan default)'
  [SEND_CERT]='When the server sends its certificate'
  [MSS_CLAMP]='TCP MSS clamping for tunnel traffic (fixes slow/stuck pages)'
  [NAT]='NAT (masquerade) VPN traffic out of the server'
  [FW_EXTRA_TCP]='Extra TCP ports to allow inbound when the firewall is on'
  [FW_EXTRA_UDP]='Extra UDP ports to allow inbound when the firewall is on'
  [LOG_LEVEL]='strongSwan log verbosity (journal)'
)
declare -A S_DEF=(
  [DNS]="$D_DNS" [POOL]="$D_POOL" [LOCAL_TS]="$D_LOCAL_TS" [IKE_PROPOSALS]="$D_IKE_PROPOSALS"
  [ESP_PROPOSALS]="$D_ESP_PROPOSALS" [DPD_DELAY]="$D_DPD_DELAY" [FRAGMENTATION]="$D_FRAGMENTATION"
  [MOBIKE]="$D_MOBIKE" [UNIQUE]="$D_UNIQUE" [REKEY_TIME]="" [REAUTH_TIME]="" [CHILD_REKEY_TIME]=""
  [CHILD_LIFE_TIME]="" [SEND_CERT]="$D_SEND_CERT" [MSS_CLAMP]="$D_MSS_CLAMP" [NAT]="$D_NAT"
  [FW_EXTRA_TCP]="" [FW_EXTRA_UDP]="" [LOG_LEVEL]="$D_LOG_LEVEL"
)
declare -A S_HINT=(
  [DNS]='comma-separated IPv4, e.g. 1.1.1.1,8.8.8.8'
  [POOL]='IPv4 CIDR /8../30, e.g. 10.30.0.0/16'
  [LOCAL_TS]='comma-separated CIDRs, e.g. 0.0.0.0/0 or 10.0.0.0/8,192.168.1.0/24'
  [IKE_PROPOSALS]='strongSwan proposal list, e.g. default,aes256-sha256-modp2048'
  [ESP_PROPOSALS]='strongSwan proposal list, e.g. default,aes256gcm16'
  [DPD_DELAY]='number + s/m/h/d, e.g. 30s'
  [FRAGMENTATION]='yes | no | force | accept'
  [MOBIKE]='yes | no'
  [UNIQUE]='no | never | keep | replace  (no = allow several sessions per user)'
  [REKEY_TIME]='e.g. 4h, 1h, 24h'
  [REAUTH_TIME]='e.g. 24h'
  [CHILD_REKEY_TIME]='e.g. 1h'
  [CHILD_LIFE_TIME]='e.g. 1h20m is NOT allowed; use one unit, e.g. 80m'
  [SEND_CERT]='always | ifasked | never'
  [MSS_CLAMP]='pmtu | off | a number 536-1460 (e.g. 1360)'
  [NAT]='yes | no'
  [FW_EXTRA_TCP]='ports, comma or space separated, e.g. 443,8080'
  [FW_EXTRA_UDP]='ports, comma or space separated'
  [LOG_LEVEL]='default | -1 | 0 | 1 | 2 | 3 | 4  (higher = more detail)'
)
declare -A S_CHECK=(
  [DNS]=v_dns [POOL]=v_pool [LOCAL_TS]=v_cidr_list [IKE_PROPOSALS]=v_props [ESP_PROPOSALS]=v_props
  [DPD_DELAY]=v_dur1 [FRAGMENTATION]='enum:yes|no|force|accept' [MOBIKE]='enum:yes|no'
  [UNIQUE]='enum:no|never|keep|replace' [REKEY_TIME]=v_dur1 [REAUTH_TIME]=v_dur1
  [CHILD_REKEY_TIME]=v_dur1 [CHILD_LIFE_TIME]=v_dur1 [SEND_CERT]='enum:always|ifasked|never'
  [MSS_CLAMP]=v_mss [NAT]='enum:yes|no' [FW_EXTRA_TCP]=v_ports [FW_EXTRA_UDP]=v_ports
  [LOG_LEVEL]='enum:default|-1|0|1|2|3|4'
)

v_ipv4() {
  local ip="$1" o
  [[ $ip =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for o in "${BASH_REMATCH[@]:1}"; do (( 10#$o <= 255 )) || return 1; done
}
v_cidr() {
  local ip="${1%/*}" p="${1#*/}"
  [[ $1 == */* && $p =~ ^[0-9]{1,2}$ ]] || return 1
  v_ipv4 "$ip" && (( 10#$p <= 32 ))
}
v_dns() { local x a; IFS=, read -ra a <<<"$1"; [[ ${#a[@]} -ge 1 ]] || return 1; for x in "${a[@]}"; do v_ipv4 "$x" || return 1; done; }
v_pool() { v_cidr "$1" && (( 10#${1#*/} >= 8 && 10#${1#*/} <= 30 )); }
v_cidr_list() { local x a; IFS=, read -ra a <<<"$1"; [[ ${#a[@]} -ge 1 ]] || return 1; for x in "${a[@]}"; do v_cidr "$x" || return 1; done; }
v_props() { [[ $1 =~ ^[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*$ ]]; }
v_dur1() { [[ $1 =~ ^[0-9]+[smhd]?$ ]]; }
v_ports() { local p; for p in ${1//,/ }; do [[ $p =~ ^[0-9]+$ ]] && (( 10#$p >= 1 && 10#$p <= 65535 )) || return 1; done; }
v_mss() { [[ $1 =~ ^(pmtu|off)$ ]] || { [[ $1 =~ ^[0-9]{3,4}$ ]] && (( 10#$1 >= 536 && 10#$1 <= 1460 )); }; }

setting_valid() { # key value
  local chk="${S_CHECK[$1]}"
  case "$chk" in
    enum:*) [[ $2 =~ ^(${chk#enum:})$ ]] ;;
    *)      "$chk" "$2" ;;
  esac
}

setting_known() { [[ -n ${S_DESC[$1]+x} ]]; }

# ---- apply: regenerate everything from config (+ roll back on failure)
settings_apply() {
  local f="$CHARON_D/ikev2-manager.conf" changed=0 new
  mkdir -p "$CHARON_D" "$ETC/custom"
  cfg_load
  new=$(mktemp)
  {
    echo "# Generated by ikev2-manager - use: vpn set LOG_LEVEL ... / vpn raw edit charon"
    if [[ $LOG_LEVEL != default ]]; then
      printf 'charon-systemd {\n  journal {\n    default = %s\n  }\n}\n' "$LOG_LEVEL"
    fi
    if [[ -s $ETC/custom/charon.conf ]]; then cat "$ETC/custom/charon.conf"; fi
  } >"$new"
  if ! cmp -s "$new" "$f" 2>/dev/null; then
    if [[ -f $f ]]; then cp -f "$f" "$f.bak"; else rm -f "$f.bak"; fi
    install -m 644 "$new" "$f"; changed=1
  fi
  rm -f "$new"
  rebuild_conf || return 1
  [[ $TESTMODE == 1 ]] && return 0
  net_apply
  if [[ $changed == 1 ]]; then
    svc_restart; sleep 2
    if [[ $(svc_active) != active ]]; then
      err "strongSwan did not start with the new daemon settings; reverting."
      if [[ -f $f.bak ]]; then cp -f "$f.bak" "$f"; else rm -f "$f"; fi
      svc_restart; return 1
    fi
  fi
  return 0
}

# ---- commands
cmd_get() {
  cfg_load
  local k v def
  if [[ -n ${1:-} ]]; then
    k="${1^^}"; setting_known "$k" || die "Unknown setting '$k'. See: vpn get"
    v="${!k}"; def="${S_DEF[$k]}"
    say "$k = ${v:-(default)}"
    say "  ${S_DESC[$k]}"; say "  accepts: ${S_HINT[$k]}"; say "  default: ${def:-(strongSwan default)}"
    return
  fi
  printf '%-18s %s\n' SETTING VALUE
  for k in "${SETTING_KEYS[@]}"; do
    v="${!k}"; def="${S_DEF[$k]}"
    if [[ $v == "$def" ]]; then v="${v:-(default)}  [default]"; fi
    printf '%-18s %s\n' "$k" "$v"
  done
}

cmd_set() {
  need_root
  local k="${1:-}" v="${2-}" oldraw newraw
  k="${k^^}"
  [[ -n $k ]] || die "Usage: vpn set KEY VALUE   (VALUE 'default' resets)  - see: vpn get"
  setting_known "$k" || die "Unknown setting '$k'. See: vpn get"
  cfg_load
  oldraw=$(grep "^$k=" "$CONF" 2>/dev/null | cut -d"'" -f2)
  if [[ -z $v || $v == default ]]; then
    newraw=""
  else
    setting_valid "$k" "$v" || die "Invalid value for $k. Accepts: ${S_HINT[$k]}"
    newraw="$v"
  fi
  cfg_set "$k" "$newraw"
  if settings_apply; then
    ok "$k = ${newraw:-default}"
    log "set $k=${newraw:-default}"
    [[ $k == POOL || $k == DNS || $k == LOCAL_TS ]] && say "Clients must reconnect to pick this up."
  else
    cfg_set "$k" "$oldraw"; settings_apply >/dev/null 2>&1
    die "The server rejected '$v' for $k - the previous value was restored."
  fi
}

cmd_reset() {
  need_root
  local k
  for k in "${SETTING_KEYS[@]}"; do cfg_set "$k" ""; done
  settings_apply && ok "All advanced settings reset to defaults (raw snippets untouched)."
}

DNS_PRESETS="cloudflare google quad9 adguard cloudflare-family opendns"
dns_preset_value() {
  case "$1" in
    cloudflare)        echo "1.1.1.1,1.0.0.1" ;;
    google)            echo "8.8.8.8,8.8.4.4" ;;
    quad9)             echo "9.9.9.9,149.112.112.112" ;;
    adguard)           echo "94.140.14.14,94.140.15.15" ;;
    cloudflare-family) echo "1.1.1.3,1.0.0.3" ;;
    opendns)           echo "208.67.222.222,208.67.220.220" ;;
    *) return 1 ;;
  esac
}

cmd_preset() {
  local kind="${1:-}" name="${2:-}" v
  case "$kind" in
    dns)
      if [[ $name == list || -z $name ]]; then
        for v in $DNS_PRESETS; do printf '  %-18s %s\n' "$v" "$(dns_preset_value "$v")"; done; return
      fi
      v=$(dns_preset_value "$name") || die "Unknown DNS preset. Options: $DNS_PRESETS"
      cmd_set DNS "$v" ;;
    ike)
      case "$name" in
        compat)      cmd_set IKE_PROPOSALS default ;;
        strict-sha2) cmd_set IKE_PROPOSALS 'default,aes256-sha256-modp2048,aes128-sha256-modp2048' ;;
        *) die "Usage: vpn preset ike compat|strict-sha2   (strict-sha2 drops the SHA-1 fallbacks)" ;;
      esac ;;
    *) die "Usage: vpn preset dns NAME|list   |   vpn preset ike compat|strict-sha2" ;;
  esac
}

# ---- raw snippets: any strongSwan option can be added through these
RAW_NAMES=(connection local remote child pools extra charon)
declare -A RAW_HELP=(
  [connection]='lines inside  connections { rw { ... } }   (e.g. reauth_time, inactivity ...)'
  [local]='lines inside the server  local { ... }  block'
  [remote]='lines inside the client  remote { ... }  block'
  [child]='lines inside  children { net { ... } }   (e.g. mode, dpd_action ...)'
  [pools]='lines inside  pools { rw_pool { ... } }   (e.g. wins, nbns, dhcp ...)'
  [extra]='whole extra sections appended to swanctl.conf (more connections, authorities, secrets ...)'
  [charon]='raw strongswan.conf fragment for the daemon (e.g. charon { dos_protection = yes })'
)

cmd_raw() {
  local sub="${1:-list}" name="${2:-}" f n ed
  if [[ $sub != list ]]; then
    [[ " ${RAW_NAMES[*]} " == *" $name "* ]] || die "Usage: vpn raw list | show|edit|set|clear NAME   (NAME: ${RAW_NAMES[*]})"
    f="$ETC/custom/$name.conf"
  fi
  case "$sub" in
    list)
      for n in "${RAW_NAMES[@]}"; do
        printf '  %-11s %-8s %s\n' "$n" "$([[ -s $ETC/custom/$n.conf ]] && echo "$(wc -l <"$ETC/custom/$n.conf") lines" || echo empty)" "${RAW_HELP[$n]}"
      done ;;
    show) [[ -s $f ]] && cat "$f" || say "(empty)" ;;
    edit|set|clear)
      need_root
      mkdir -p "$ETC/custom"
      if [[ -f $f ]]; then cp -f "$f" "$f.prev"; else : >"$f.prev"; fi
      case "$sub" in
        edit)
          [[ -t 0 && -t 1 ]] || die "'edit' needs a terminal. Use: vpn raw set $name < file"
          ed="${EDITOR:-}"; [[ -n $ed ]] || ed=$(command -v nano || command -v vi || true)
          [[ -n $ed ]] || die "No editor found (install nano or set EDITOR)."
          [[ -f $f ]] || : >"$f"
          "$ed" "$f" ;;
        set)   cat >"$f" ;;
        clear) : >"$f" ;;
      esac
      if settings_apply; then
        ok "Applied: $name"; log "raw $sub $name"
      else
        cp -f "$f.prev" "$f"; settings_apply >/dev/null 2>&1
        die "The server rejected this snippet - the previous content was restored."
      fi ;;
    *) die "Usage: vpn raw list | show|edit|set|clear NAME" ;;
  esac
}

cmd_conf() {
  case "${1:-show}" in
    show)
      sed -E 's/(secret = ").*(")/\1********\2/' "$SWAN/swanctl.conf"
      if [[ -s $CHARON_D/ikev2-manager.conf ]]; then
        echo; echo "# --- $CHARON_D/ikev2-manager.conf"; cat "$CHARON_D/ikev2-manager.conf"
      fi ;;
    apply) need_root; settings_apply && ok "Configuration regenerated and applied." ;;
    *) die "Usage: vpn conf show|apply" ;;
  esac
}

# ---- advanced settings menus
tui_presets() {
  local i=1 n ans v
  while true; do
    ui_header "Presets"
    echo; echo " DNS providers:"
    i=1
    for n in $DNS_PRESETS; do ui_item "$i" "$(printf '%-18s %s' "$n" "$(dns_preset_value "$n")")"; i=$((i+1)); done
    echo; echo " IKE strictness:"
    ui_item a "compat       (default; accepts SHA-1 fallbacks)"
    ui_item b "strict-sha2  (SHA-2 only)"
    ui_item 0 "Back"
    ui_choose
    case $CHOICE in
      0|"") return ;;
      a) ui_show "$( (cmd_preset ike compat) 2>&1 )" ;;
      b) ui_show "$( (cmd_preset ike strict-sha2) 2>&1 )" ;;
      *) if [[ $CHOICE =~ ^[0-9]+$ ]]; then
           n=$(echo $DNS_PRESETS | tr ' ' '\n' | sed -n "${CHOICE}p")
           [[ -n $n ]] && ui_show "$( (cmd_preset dns "$n") 2>&1 )"
         fi ;;
    esac
  done
}

tui_raw() {
  local i n
  while true; do
    ui_header "Raw config snippets"
    echo; echo " Add ANY strongSwan option here. It is validated by loading it;"
    echo " if the server rejects it, the previous content is restored."; echo
    i=1
    for n in "${RAW_NAMES[@]}"; do
      ui_item "$i" "$(printf '%-11s %s' "$n" "$([[ -s $ETC/custom/$n.conf ]] && echo '(has content)' || echo '(empty)')")"
      echo "        $(c 2)${RAW_HELP[$n]}$(c 0)"
      i=$((i+1))
    done
    ui_item 0 "Back"
    ui_choose
    case $CHOICE in
      0|"") return ;;
      *) if [[ $CHOICE =~ ^[0-9]+$ && $CHOICE -ge 1 && $CHOICE -le ${#RAW_NAMES[@]} ]]; then
           n="${RAW_NAMES[$((CHOICE-1))]}"
           ui_run cmd_raw edit "$n"
         fi ;;
    esac
  done
}

tui_advanced() {
  local i k v out
  while true; do
    cfg_load
    ui_header "Advanced strongSwan settings"
    echo; i=1
    for k in "${SETTING_KEYS[@]}"; do
      v="${!k}"; [[ -n $v ]] || v="(default)"
      printf '  %s%2d)%s %-17s %s\n' "$(c '1;33')" "$i" "$(c 0)" "$k" "${v:0:32}"
      i=$((i+1))
    done
    echo
    ui_item p "Presets (DNS providers, IKE strictness)"
    ui_item r "Raw snippets - edit ANY strongSwan option"
    ui_item v "View generated swanctl.conf"
    ui_item x "Reset all settings to defaults"
    ui_item 0 "Back"
    ui_choose
    case $CHOICE in
      0|"") return ;;
      p) tui_presets ;;
      r) tui_raw ;;
      v) ui_show "$( (cmd_conf show) 2>&1 )" ;;
      x) echo; if ui_yesno "Reset all advanced settings to defaults?" n; then ui_run cmd_reset; fi ;;
      *) if [[ $CHOICE =~ ^[0-9]+$ && $CHOICE -ge 1 && $CHOICE -le ${#SETTING_KEYS[@]} ]]; then
           k="${SETTING_KEYS[$((CHOICE-1))]}"
           echo
           echo " $k - ${S_DESC[$k]}"
           echo " Accepts : ${S_HINT[$k]}"
           echo " Default : ${S_DEF[$k]:-(strongSwan default)}"
           echo " Current : ${!k:-(default)}"
           v=$(ui_ask "New value (Enter = keep, 'default' = reset)"); echo
           if [[ -n $v ]]; then out=$( cmd_set "$k" "$v" 2>&1 ); ui_show "$out"; fi
         fi ;;
    esac
  done
}

# ------------------------------------------------------------ setup (used by the installer)
cmd_setup() {
  need_root
  local mode=ip domain="" email="" user="user1" pass="" fw=no f2b=no au=no tok="" aid="" ip=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --mode)       mode="$2"; shift 2 ;;
      --domain)     domain="$2"; mode=domain; shift 2 ;;
      --email)      email="$2"; shift 2 ;;
      --user)       user="$2"; shift 2 ;;
      --pass)       pass="$2"; shift 2 ;;
      --ip)         ip="$2"; shift 2 ;;
      --firewall)   fw="$2"; shift 2 ;;
      --fail2ban)   f2b="$2"; shift 2 ;;
      --autoupdate) au="$2"; shift 2 ;;
      --bot-token)  tok="$2"; shift 2 ;;
      --admin-id)   aid="$2"; shift 2 ;;
      --update-base) cfg_set UPDATE_BASE "$2"; shift 2 ;;
      *) die "setup: unknown option $1" ;;
    esac
  done
  [[ $mode == domain && -z $domain ]] && die "Domain mode needs --domain"
  [[ $user =~ $NAME_RE ]] || die "Invalid username"
  [[ -z $pass || $pass =~ $PASS_RE ]] || die "Invalid password (8-64 chars: letters, digits, . _ @ + = , ! % ^ * ~ -)"

  mkdir -p "$ETC" "$VAR" "$BACKUPS"; chmod 700 "$ETC" "$BACKUPS"; : >>"$LOGFILE"

  step "Installing packages (this can take a minute)"
  export DEBIAN_FRONTEND=noninteractive
  [[ $TESTMODE == 1 ]] || apt-get update >>"$LOGFILE" 2>&1 || warn "apt-get update reported errors (see $LOGFILE)"
  apt_install strongswan strongswan-swanctl strongswan-pki charon-systemd \
    libcharon-extra-plugins libcharon-extauth-plugins iptables curl openssl python3 ca-certificates
  [[ $TESTMODE == 1 ]] || systemctl disable --now strongswan-starter >/dev/null 2>&1 || true

  step "Detecting server address"
  [[ -n $ip ]] || ip=$(detect_public_ip) || die "Could not detect the public IP. Re-run with --ip YOUR_IP"
  cfg_set SERVER_IP "$ip"; cfg_set IFACE "$(default_iface)"
  say "  Public IP: $ip   Interface: $(default_iface)"

  # keep a copy of any pre-existing manual config, then clear it
  if [[ -f $SWAN/swanctl.conf ]] && ! grep -q 'ikev2-manager' "$SWAN/swanctl.conf"; then
    local old="$BACKUPS/pre-install-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$old"; cp -a "$SWAN" "$old/" 2>/dev/null || true
    say "  Existing strongSwan config backed up to $old"
    rm -f "$SWAN"/x509/* "$SWAN"/x509ca/* "$SWAN"/private/* "$SWAN/swanctl.conf" 2>/dev/null || true
  fi

  if [[ $mode == domain ]]; then mode_setup_domain "$domain" "$email"; else mode_setup_ip "$ip"; fi

  step "Creating first user"
  users_ensure
  if user_exists "$user"; then pass=$(user_get "$user" 2); else
    [[ -n $pass ]] || pass=$(gen_pass)
    printf '%s:%s:enabled:%s\n' "$user" "$pass" "$(date +%s)" >>"$USERS"
  fi

  step "Configuring services"
  install_units
  if [[ $TESTMODE != 1 ]]; then
    systemctl enable "$(svc_name)" >/dev/null 2>&1 || true
    systemctl restart "$(svc_name)" || warn "Could not start $(svc_name)"
    sleep 2
  fi
  rebuild_conf || die "Could not load VPN configuration (see: vpn logs)"
  cfg_set FIREWALL "$fw"
  if [[ $fw == yes ]]; then cfg_set FW_SSH_PORTS "$(fw_ssh_ports)"; fi
  if [[ $TESTMODE != 1 ]]; then
    systemctl enable ikev2-net >/dev/null 2>&1 || true
    net_apply
    systemctl enable --now ikev2-certcheck.timer >/dev/null 2>&1 || true
  fi
  [[ $f2b == yes ]] && sec_fail2ban
  [[ $au == yes ]]  && sec_autoupdate
  if [[ -n $tok && -n $aid ]]; then cmd_bot setup "$tok" "$aid" || warn "Bot setup failed; run 'vpn bot setup' later."; fi

  local healthy="no"
  if [[ $TESTMODE == 1 ]] || { [[ $(svc_active) == active ]] && run_swanctl --list-conns 2>/dev/null | grep -q '^rw:'; }; then healthy=yes; fi

  say
  ok "================ INSTALL COMPLETE ================"
  say " Server address : $(grep "^SERVER_NAME=" "$CONF" | cut -d"'" -f2)"
  say " Username       : $user"
  say " Password       : $pass"
  say " Health check   : $healthy"
  say " Manage         : sudo vpn   (text menu)"
  [[ $mode == ip ]] && say " Client trust   : use 'vpn profile $user' (CA is embedded in the profiles)"
  say
  warn "Open UDP 500 and UDP 4500 (and TCP 80 for domain mode) in your cloud firewall / Security Group."
  [[ $healthy == yes ]] || warn "VPN did not pass the health check. Run: sudo vpn logs"
}

# ------------------------------------------------------------ migrate / selftest / update
cmd_migrate() {
  [[ -f $CONF ]] || return 0
  cfg_load; users_ensure
  mkdir -p "$VAR" "$BACKUPS"
  install_units
  [[ -n $SERVER_NAME ]] && rebuild_conf
  [[ $TESTMODE == 1 ]] || net_apply
  return 0
}

cmd_selftest() {
  local rc=0 cmd
  bash -n "$SELF" 2>/dev/null || { err "vpn script has syntax errors"; rc=1; }
  python3 -m py_compile "$OPT/bot.py" "$OPT/ikev2lib.py" 2>/dev/null || { err "python files do not compile"; rc=1; }
  # run real commands and fail on shell runtime errors written to stderr
  local out
  for cmd in "version" "get" "status --kv" "user list"; do
    out=$("$SELF" $cmd 2>&1 >/dev/null) || true
    if grep -Eq 'command not found|unbound variable|syntax error|bad substitution' <<<"$out"; then
      err "runtime error in 'vpn $cmd': $(head -1 <<<"$out")"; rc=1
    fi
  done
  if [[ -f $CONF && $TESTMODE != 1 ]]; then
    [[ $(svc_active) == active ]] || { err "VPN service is not active"; rc=1; }
  fi
  return $rc
}

version_older() { # $1 older than $2 ?
  [[ $1 != "$2" && $(printf '%s\n%s\n' "$1" "$2" | sort -V | head -1) == "$1" ]]
}

cmd_update() {
  need_root
  local src="" force=0 yes=0 check=0 notify=0 saveonly=0 base="" a latest tmp new cur flags=() v
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;; --yes|-y) yes=1 ;; --check) check=1 ;; --notify) notify=1 ;;
      --save-only) saveonly=1 ;;
      --base) base="$2"; shift ;;
      *) src="$1" ;;
    esac
    shift
  done
  cfg_load
  if [[ -n $base ]]; then
    [[ $base =~ ^(https?|file)://[^[:space:]]+$ ]] || die "Invalid base URL."
    base="${base%/}"; cfg_set UPDATE_BASE "$base"; UPDATE_BASE="$base"; ok "Update source saved: $base"
    [[ $saveonly == 1 ]] && return 0
  fi
  [[ $notify == 1 ]] && flags+=(--notify)
  cur="$VERSION"

  # --- local folder (cloned repo) or installer file/URL
  if [[ -n $src ]]; then
    if [[ -d $src ]]; then
      [[ -f $src/install.sh && -f $src/vpn && -f $src/VERSION ]] || die "$src is not an ikev2-manager repo folder."
      new=$(tr -d '[:space:]' <"$src/VERSION")
      say "Installed: $cur   Folder: $new"
      if [[ $yes == 0 ]]; then read -rp "Install this version? [y/N] " a; [[ $a == y || $a == Y ]] || die "Cancelled."; fi
      bash "$src/install.sh" --upgrade --from "$src" "${flags[@]}"; return $?
    fi
    tmp=$(mktemp /tmp/ikev2-update.XXXXXX)
    if [[ $src =~ ^https?:// ]]; then curl -fsSL --max-time 60 "$src" -o "$tmp" || die "Download failed"
    else [[ -f $src ]] || die "Not found: $src"; cp "$src" "$tmp"; fi
    head -c 4096 "$tmp" | grep -q 'IKEV2MGR-INSTALLER' || die "This is not an ikev2-manager install.sh."
    bash -n "$tmp" 2>/dev/null || die "install.sh has syntax errors."
    IKEV2MGR_BASE="${UPDATE_BASE:-}" bash "$tmp" --upgrade "${flags[@]}"; return $?
  fi

  # --- remote (GitHub raw) update
  [[ -n ${UPDATE_BASE:-} ]] || die "No update source configured. Run: vpn update --base https://raw.githubusercontent.com/USER/REPO/main --save-only"
  latest=$(curl -fsSL --max-time 20 "$UPDATE_BASE/VERSION" 2>/dev/null | tr -d '[:space:]') \
    || die "Could not reach $UPDATE_BASE/VERSION"
  [[ $latest =~ ^[0-9]+(\.[0-9]+)*([-.][A-Za-z0-9]+)*$ ]] || die "Remote VERSION file is not valid: '$latest'"
  if [[ $check == 1 ]]; then
    printf 'installed=%s\nlatest=%s\n' "$cur" "$latest"
    if version_older "$cur" "$latest"; then say "Update available: $cur -> $latest  (run: sudo vpn update)"
    elif [[ $cur == "$latest" ]]; then say "Up to date."
    else say "Installed version ($cur) is newer than the source ($latest)."; fi
    return 0
  fi
  say "Installed version: $cur"; say "Latest version:    $latest"
  if [[ $latest == "$cur" && $force == 0 ]]; then ok "Already up to date (use --force to reinstall)."; return 0; fi
  if version_older "$latest" "$cur" && [[ $force == 0 ]]; then die "Remote version is older than installed. Use --force to downgrade."; fi
  if [[ $yes == 0 ]]; then
    read -rp "Update now? Users, certificates and settings are kept. [y/N] " a
    [[ $a == y || $a == Y ]] || die "Cancelled."
  fi
  tmp=$(mktemp /tmp/ikev2-update.XXXXXX)
  curl -fsSL --max-time 60 "$UPDATE_BASE/install.sh" -o "$tmp" || die "Could not download install.sh"
  head -c 4096 "$tmp" | grep -q 'IKEV2MGR-INSTALLER' || die "Downloaded install.sh is not valid."
  bash -n "$tmp" 2>/dev/null || die "Downloaded install.sh has syntax errors."
  IKEV2MGR_BASE="$UPDATE_BASE" bash "$tmp" --upgrade "${flags[@]}"
}

# ------------------------------------------------------------ uninstall
cmd_uninstall() {
  need_root
  local purge=0 yes=0 a ans
  for a in "$@"; do case "$a" in --purge) purge=1 ;; --yes) yes=1 ;; esac; done
  if [[ $yes == 0 ]]; then
    warn "This removes the VPN manager, bot, firewall rules and VPN configuration."
    [[ $purge == 1 ]] && warn "--purge also removes strongSwan packages and ALL data in $ETC."
    read -rp "Type YES to continue: " ans
    [[ $ans == YES ]] || die "Aborted."
  fi
  step "Creating a final backup"
  cmd_backup || true
  step "Stopping services"
  systemctl disable --now ikev2-bot ikev2-certcheck.timer ikev2-net >/dev/null 2>&1 || true
  net_clear
  rm -f /etc/systemd/system/ikev2-{net,bot,certcheck}.service /etc/systemd/system/ikev2-certcheck.timer
  systemctl daemon-reload
  rm -f "$SWAN/swanctl.conf" "$SWAN/swanctl.conf.bak" "$SWAN/x509/server.pem" "$SWAN/x509ca/ikev2-ca.pem" \
        "$SWAN/private/server.key" "$SWAN/x509ica/le-chain.pem" /etc/sysctl.d/99-ikev2.conf
  if [[ $purge == 1 ]]; then
    step "Removing packages and data"
    systemctl disable --now "$(svc_name)" >/dev/null 2>&1 || true
    DEBIAN_FRONTEND=noninteractive apt-get purge -y strongswan strongswan-swanctl strongswan-pki charon-systemd \
      libcharon-extra-plugins libcharon-extauth-plugins >>"$LOGFILE" 2>&1 || true
    rm -rf "$ETC" "$VAR"
  else
    svc_restart 2>/dev/null || true
  fi
  rm -rf "$OPT"
  ok "Uninstalled. Final backup is in $BACKUPS"
  rm -f /usr/local/bin/vpn
}

# ------------------------------------------------------------ text UI (plain numbered menus, no extra packages)
ui_tty()   { [[ -t 0 && -t 1 ]]; }
ui_clear() { if ui_tty; then printf '\033[H\033[2J\033[3J'; fi; return 0; }
ui_pause() { local _; read -rp " Press Enter to continue... " _ || true; }

ui_header() { # title
  ui_clear
  local w=42 line
  line=$(printf '═%.0s' $(seq 1 $w))
  printf '%s ╔%s╗\n ║ %-*s ║\n ╚%s╝%s\n' "$(c '1;36')" "$line" $((w-2)) "$1" "$line" "$(c 0)"
}

ui_item() { printf '  %s%s)%s %s\n' "$(c '1;33')" "$1" "$(c 0)" "$2"; }

ui_choose() { # sets CHOICE
  local ans
  printf '\n'
  if ! read -rp " Select: " ans; then CHOICE=0; echo; return; fi
  CHOICE="${ans//[[:space:]]/}"
}

ui_ask() { # prompt [default]  -> prints value
  local v
  read -rp " $1${2:+ [$2]}: " v || v=""
  printf '%s' "${v:-${2:-}}"
}

ui_yesno() { # prompt [default y|n] -> 0 = yes
  local d="${2:-n}" a
  read -rp " $1 [$([[ $d == y ]] && echo Y/n || echo y/N)] " a || a=""
  a="${a:-$d}"
  [[ $a == y || $a == Y ]]
}

ui_run() { echo; ( "$@" ); local rc=$?; echo; [[ $rc -eq 0 ]] || warn "(finished with errors)"; ui_pause; }

ui_show() { echo; printf '%s\n' "$1"; echo; ui_pause; }

ui_dash() {
  cfg_load
  local svc users on dot
  svc=$(svc_active); users=$(user_count)
  on=$(python3 "$OPT/ikev2lib.py" count 2>/dev/null || echo 0)
  if [[ $svc == active ]]; then dot="$(c 32)● running$(c 0)"; else dot="$(c 31)● ${svc:-unknown}$(c 0)"; fi
  printf ' Server : %s (%s mode)\n Service: %s\n Users  : %s     Online now: %s\n' "$SERVER_NAME" "$MODE" "$dot" "$users" "$on"
}

ui_pick_user() { # sets PICKED
  PICKED=""
  local lines=() i=1 n s l ans
  while IFS='|' read -r n s _; do lines+=("$n|$s"); done < <(cmd_user_list --plain)
  if [[ ${#lines[@]} -eq 0 ]]; then warn " No users yet."; ui_pause; return 1; fi
  echo
  for l in "${lines[@]}"; do ui_item "$i" "${l%%|*}  $(c 2)(${l##*|})$(c 0)"; i=$((i+1)); done
  ui_item 0 "Cancel"
  read -rp " Select user: " ans || return 1
  [[ $ans =~ ^[0-9]+$ && $ans -ge 1 && $ans -le ${#lines[@]} ]] || return 1
  PICKED="${lines[$((ans-1))]%%|*}"
}

# ---- users
tui_profile() { # name
  local name="$1" dir out
  while true; do
    ui_header "Profile: $name"
    echo
    ui_item 1 "Show connection info (server / user / password)"
    ui_item 2 "Export profile files (Android, iPhone, Windows)"
    ui_item 3 "Show CA certificate text (to copy by hand)"
    ui_item 4 "Show ZedSecure import link"
    ui_item 0 "Back"
    ui_choose
    case $CHOICE in
      1) ui_show "$( (cmd_user_show "$name") 2>&1 )" ;;
      2) dir="$EXPORTS/$name"
         if out=$( (profile_make "$name" "$dir") 2>&1 ); then
           ui_show "Saved in: $dir
$(ls -1 "$dir")

Download them from your computer, for example:
  scp -i KEY.pem ubuntu@$SERVER_NAME:$dir/* .
Or just use the Telegram bot: it sends the files directly."
         else ui_show "$out"; fi ;;
      3) ui_show "$( (cmd_ca) 2>&1 )" ;;
      4) ui_show "Copy the whole link and import it from the clipboard in ZedSecure:

$( (cmd_zed "$name") 2>&1 )

(Without password: vpn zed $name --nopw)" ;;
      0|"") return ;;
    esac
  done
}

tui_users() {
  local name pass out
  while true; do
    ui_header "Users & profiles"
    echo; cmd_user_list; echo
    ui_item 1 "Add user"
    ui_item 2 "Profile / connection info"
    ui_item 3 "Enable or disable a user"
    ui_item 4 "Change password"
    ui_item 5 "Delete user"
    ui_item 0 "Back"
    ui_choose
    case $CHOICE in
      1) echo; name=$(ui_ask "New username (letters, digits, _ . -)"); echo
         [[ -n $name ]] || continue
         pass=$(ui_ask "Password (Enter = random)"); echo
         out=$( cmd_user_add "$name" ${pass:+"$pass"} 2>&1 ); ui_show "$out" ;;
      2) ui_pick_user && tui_profile "$PICKED" ;;
      3) ui_pick_user || continue
         if [[ $(user_get "$PICKED" 3) == enabled ]]; then out=$( cmd_user_setstatus "$PICKED" disabled 2>&1 )
         else out=$( cmd_user_setstatus "$PICKED" enabled 2>&1 ); fi
         ui_show "$out" ;;
      4) ui_pick_user || continue
         echo; pass=$(ui_ask "New password (Enter = random)"); echo
         out=$( cmd_user_passwd "$PICKED" ${pass:+"$pass"} 2>&1 ); ui_show "$out" ;;
      5) ui_pick_user || continue
         echo
         if ui_yesno "Delete '$PICKED'? This cannot be undone." n; then
           out=$( cmd_user_del "$PICKED" 2>&1 ); ui_show "$out"
         fi ;;
      0|"") return ;;
    esac
  done
}

