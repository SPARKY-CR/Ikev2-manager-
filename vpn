#!/usr/bin/env bash
# vpn - IKEv2 (strongSwan) manager: CLI + TUI
# Part of ikev2-manager.
set -uo pipefail

ETC="${IKEV2_ETC:-/etc/ikev2}"
VAR="${IKEV2_VAR:-/var/lib/ikev2}"
OPT="${IKEV2_OPT:-/opt/ikev2}"
SWAN="${IKEV2_SWAN:-/etc/swanctl}"
BACKUPS="${IKEV2_BACKUPS:-/var/backups/ikev2}"
EXPORTS="${IKEV2_EXPORTS:-/root/ikev2-profiles}"
CONF="$ETC/config.env"
USERS="$ETC/users.db"
PKI="$ETC/pki"
LOGFILE="${IKEV2_LOG:-/var/log/ikev2-manager.log}"
SYSCTL_D="${IKEV2_SYSCTL_D:-/etc/sysctl.d}"
UNIT_DIR="${IKEV2_UNIT_DIR:-/etc/systemd/system}"
F2B_D="${IKEV2_F2B_D:-/etc/fail2ban/jail.d}"
APT_D="${IKEV2_APT_D:-/etc/apt/apt.conf.d}"
BIN_PATH="${IKEV2_BIN:-/usr/local/bin/vpn}"
LE_DIR="${IKEV2_LE:-/etc/letsencrypt}"
BACKUP_PUB="$ETC/backup-cert.pem"   # certificate used to encrypt backups; the PRIVATE key is never kept on the server
RELEASE_PUB="$ETC/release.pub"      # pinned release-signing key (updates must be signed by it)
VERSION="$(cat "$OPT/VERSION" 2>/dev/null || echo dev)"
TESTMODE="${IKEV2_TEST:-0}"
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"


# ---- defaults for every tunable setting (empty value in config.env = default)
D_UPDATE_BASE='https://raw.githubusercontent.com/SPARKY-CR/Ikev2-manager-/main'
D_POOL='10.30.0.0/16'
D_DNS='1.1.1.1,8.8.8.8'
D_LOCAL_TS='0.0.0.0/0'
D_IKE_PROPOSALS='default,aes256-sha256-modp2048,aes128-sha256-modp2048,aes256-sha1-modp2048,aes128-sha1-modp2048'
D_ESP_PROPOSALS='default,aes256-sha256-modp2048,aes128-sha256-modp2048,aes256-sha256,aes128-sha256,aes256gcm16,aes128gcm16'
D_DPD_DELAY='30s'
D_FRAGMENTATION='yes'
D_MOBIKE='yes'
D_UNIQUE='no'
D_SEND_CERT='always'
D_MSS_CLAMP='pmtu'
D_NAT='yes'
D_LOG_LEVEL='default'
D_CLIENT_ISOLATION='yes'
D_BLOCK_PRIVATE='yes'
D_IKE_RATE_LIMIT='off'
D_IPV6_BLOCK='no'
D_QUOTA_ACTION='disable'

NAME_RE='^[A-Za-z0-9][A-Za-z0-9_.-]{0,31}$'
PASS_RE='^[A-Za-z0-9._@+=,!%^*~-]{12,64}$'          # new passwords
DOMAIN_RE='^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?\.[A-Za-z]{2,}$'
EMAIL_RE='^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'
PASS_MSG="Invalid password. Use 12-64 chars: letters, digits and . _ @ + = , ! % ^ * ~ -"

# ------------------------------------------------------------ output helpers
c()    { if [[ -t 1 ]]; then printf '\e[%sm' "$1"; fi; }
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s%s%s\n' "$(c 32)" "$*" "$(c 0)"; }
warn() { printf '%s%s%s\n' "$(c 33)" "$*" "$(c 0)" >&2; }
err()  { printf '%s%s%s\n' "$(c 31)" "Error: $*" "$(c 0)" >&2; }
die()  { err "$*"; exit 1; }
step() { printf '%s==>%s %s\n' "$(c 36)" "$(c 0)" "$*"; log "STEP $*"; }
log()  { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOGFILE" 2>/dev/null || true; }

need_root() {
  [[ $TESTMODE == 1 || $EUID -eq 0 ]] || die "Run as root: sudo vpn"
}

# ------------------------------------------------------------ system wrappers
run_swanctl() {
  [[ $TESTMODE == 1 ]] && return 0
  local out rc
  out=$(swanctl "$@" 2>&1); rc=$?
  printf '%s\n' "$out" | grep -Ev "^plugin '|CAP_SETUID|^$" || true
  return $rc
}

svc_name() {
  local u
  for u in strongswan-swanctl strongswan; do
    if systemctl cat "$u.service" 2>/dev/null | grep -q charon-systemd; then
      echo "$u"; return
    fi
  done
  echo strongswan
}

svc_active() {
  [[ $TESTMODE == 1 ]] && { echo active; return; }
  systemctl is-active "$(svc_name)" 2>/dev/null || true
}

svc_restart() {
  [[ $TESTMODE == 1 ]] && return 0
  systemctl restart "$(svc_name)"
}

apt_install() {
  [[ $TESTMODE == 1 ]] && return 0
  export DEBIAN_FRONTEND=noninteractive
  if ! apt-get install -y "$@" >>"$LOGFILE" 2>&1; then
    tail -n 15 "$LOGFILE" >&2
    die "apt-get install failed: $*"
  fi
}

# ------------------------------------------------------------ config
# config.env is PARSED (never sourced) and only these keys are read from it.
CFG_KEYS=" MODE SERVER_NAME SERVER_IP IFACE DOMAIN CA_CN BOT_TOKEN ADMIN_ID EMAIL FIREWALL FW_SSH_PORTS UPDATE_BASE FAIL2BAN AUTOUPDATE POOL DNS LOCAL_TS IKE_PROPOSALS ESP_PROPOSALS DPD_DELAY FRAGMENTATION MOBIKE UNIQUE REKEY_TIME REAUTH_TIME CHILD_REKEY_TIME CHILD_LIFE_TIME SEND_CERT MSS_CLAMP NAT FW_EXTRA_TCP FW_EXTRA_UDP LOG_LEVEL CLIENT_ISOLATION BLOCK_PRIVATE IKE_RATE_LIMIT IPV6_BLOCK QUOTA_ACTION DEFAULT_LIMIT DEFAULT_DAYS "

cfg_load() {
  MODE=""; SERVER_NAME=""; SERVER_IP=""; IFACE=""; DOMAIN=""; CA_CN=""; BOT_TOKEN=""; ADMIN_ID=""
  EMAIL=""; FIREWALL=""; FW_SSH_PORTS=""; UPDATE_BASE=""; FAIL2BAN=""; AUTOUPDATE=""
  POOL=""; DNS=""; LOCAL_TS=""; IKE_PROPOSALS=""; ESP_PROPOSALS=""; DPD_DELAY=""; FRAGMENTATION=""
  MOBIKE=""; UNIQUE=""; REKEY_TIME=""; REAUTH_TIME=""; CHILD_REKEY_TIME=""; CHILD_LIFE_TIME=""
  SEND_CERT=""; MSS_CLAMP=""; NAT=""; FW_EXTRA_TCP=""; FW_EXTRA_UDP=""; LOG_LEVEL=""
  CLIENT_ISOLATION=""; BLOCK_PRIVATE=""; IKE_RATE_LIMIT=""; IPV6_BLOCK=""
  QUOTA_ACTION=""; DEFAULT_LIMIT=""; DEFAULT_DAYS=""
  if [[ -f $CONF ]]; then
    local _line _k _v
    while IFS= read -r _line || [[ -n $_line ]]; do
      [[ $_line =~ ^([A-Z][A-Z0-9_]*)=\'(.*)\'$ ]] || continue
      _k="${BASH_REMATCH[1]}"; _v="${BASH_REMATCH[2]}"
      [[ $CFG_KEYS == *" $_k "* ]] || continue
      _v="${_v//\'\\\'\'/\'}"
      printf -v "$_k" '%s' "$_v"
    done <"$CONF"
  fi
  : "${MODE:=ip}" "${CA_CN:=IKEv2 VPN CA}" "${FIREWALL:=no}" "${FW_SSH_PORTS:=22}"
  : "${POOL:=$D_POOL}" "${DNS:=$D_DNS}" "${LOCAL_TS:=$D_LOCAL_TS}" "${IKE_PROPOSALS:=$D_IKE_PROPOSALS}"
  : "${ESP_PROPOSALS:=$D_ESP_PROPOSALS}" "${DPD_DELAY:=$D_DPD_DELAY}" "${FRAGMENTATION:=$D_FRAGMENTATION}"
  : "${MOBIKE:=$D_MOBIKE}" "${UNIQUE:=$D_UNIQUE}" "${SEND_CERT:=$D_SEND_CERT}" "${MSS_CLAMP:=$D_MSS_CLAMP}"
  : "${NAT:=$D_NAT}" "${LOG_LEVEL:=$D_LOG_LEVEL}" "${UPDATE_BASE:=$D_UPDATE_BASE}"
  : "${CLIENT_ISOLATION:=$D_CLIENT_ISOLATION}" "${BLOCK_PRIVATE:=$D_BLOCK_PRIVATE}"
  : "${IKE_RATE_LIMIT:=$D_IKE_RATE_LIMIT}" "${IPV6_BLOCK:=$D_IPV6_BLOCK}" "${QUOTA_ACTION:=$D_QUOTA_ACTION}"
}

# ---- global lock: every command that changes state runs under it (re-entrant, 120 s timeout)
_LOCK_FD=""
locked() { # locked CMD [ARGS...]
  if [[ -n $_LOCK_FD ]] || ! command -v flock >/dev/null 2>&1; then "$@"; return $?; fi
  mkdir -p "$ETC" 2>/dev/null
  # NB: the 2>/dev/null must wrap a group - on a bare `exec` it would redirect this shell's stderr for good
  if ! { exec {_LOCK_FD}>>"$ETC/.lock"; } 2>/dev/null; then _LOCK_FD=""; "$@"; return $?; fi
  if ! flock -w "${IKEV2_LOCK_TIMEOUT:-120}" "$_LOCK_FD"; then
    exec {_LOCK_FD}>&-; _LOCK_FD=""
    err "another vpn command is still running (waited ${IKEV2_LOCK_TIMEOUT:-120} s)"; return 1
  fi
  local _rc=0
  "$@" || _rc=$?
  exec {_LOCK_FD}>&-; _LOCK_FD=""
  return $_rc
}

# cfg_set KEY VALUE : atomic write; refuses control characters (they would corrupt the file)
cfg_set() { locked _cfg_set "$@"; }
_cfg_set() {
  local k="$1" v="$2" t
  [[ $k =~ ^[A-Z][A-Z0-9_]*$ ]] || { err "bad config key: $k"; return 1; }
  [[ $v != *[[:cntrl:]]* ]] || { err "the value of $k must not contain line breaks or control characters"; return 1; }
  mkdir -p "$ETC"
  [[ -f $CONF ]] || { : >"$CONF"; chmod 600 "$CONF"; }
  t=$(mktemp "$CONF.XXXXXX") || return 1
  { grep -v "^${k}=" "$CONF" || true; printf "%s='%s'\n" "$k" "${v//\'/\'\\\'\'}"; } >"$t" || { rm -f "$t"; return 1; }
  chmod 600 "$t"; mv -f "$t" "$CONF"
}

# cfg_raw KEY : the value stored in config.env for KEY (empty when unset) - no defaults applied
cfg_raw() {
  local _line _out=""
  [[ -f $CONF ]] || return 0
  while IFS= read -r _line || [[ -n $_line ]]; do
    if [[ $_line =~ ^$1=\'(.*)\'$ ]]; then _out="${BASH_REMATCH[1]}"; _out="${_out//\'\\\'\'/\'}"; fi
  done <"$CONF"
  printf '%s' "$_out"
}

# ------------------------------------------------------------ users db
# format: name:password:status:created_epoch      (all writes are atomic and run under the lock)
users_ensure() { mkdir -p "$ETC"; [[ -f $USERS ]] || : >"$USERS"; chmod 600 "$USERS"; }
user_exists()  { [[ -f $USERS ]] && n="$1" awk -F: '$1==ENVIRON["n"]{f=1} END{exit !f}' "$USERS"; }
user_get()     { n="$1" f="$2" awk -F: '$1==ENVIRON["n"]{print $(ENVIRON["f"]+0); exit}' "$USERS"; }
user_count()   { [[ -f $USERS ]] && awk 'END{print NR}' "$USERS" || echo 0; }
user_enabled_count() { [[ -f $USERS ]] && awk -F: '$3=="enabled"{n++} END{print n+0}' "$USERS" || echo 0; }

user_set() { # NAME FIELD VALUE
  local t; t=$(mktemp "$USERS.XXXXXX") || return 1
  if n="$1" f="$2" v="$3" awk -F: -v OFS=: '$1==ENVIRON["n"]{$(ENVIRON["f"]+0)=ENVIRON["v"]}1' "$USERS" >"$t"; then
    chmod 600 "$t"; mv -f "$t" "$USERS"
  else rm -f "$t"; return 1; fi
}

user_remove() {
  local t; t=$(mktemp "$USERS.XXXXXX") || return 1
  if n="$1" awk -F: '$1!=ENVIRON["n"]' "$USERS" >"$t"; then chmod 600 "$t"; mv -f "$t" "$USERS"
  else rm -f "$t"; return 1; fi
}

# snapshot/rollback of the whole DB (used when swanctl refuses the new config)
users_snapshot() { local t; t=$(mktemp "$USERS.snap.XXXXXX") || return 1; cat "$USERS" >"$t"; chmod 600 "$t"; printf '%s' "$t"; }
users_restore()  { [[ -f ${1:-} ]] && mv -f "$1" "$USERS"; }
users_discard()  { [[ -n ${1:-} ]] && rm -f "$1"; return 0; }

# pass_check NAME PASSWORD -> 0 when acceptable, else 1 with the reason in $PASS_ERR
pass_check() {
  local n="${1,,}" p="$2" lp="${2,,}" core w
  PASS_ERR=""
  if ! [[ $p =~ $PASS_RE ]]; then PASS_ERR="$PASS_MSG"; return 1; fi
  if [[ $(fold -w1 <<<"$p" | sort -u | wc -l) -le 3 ]]; then PASS_ERR="Password is too weak (too few different characters)."; return 1; fi
  if [[ "01234567890123456789012345678901234567890123456789 abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyz qwertyuiopasdfghjklzxcvbnmqwertyuiop" == *"$lp"* ]]; then
    PASS_ERR="Password is too weak (a simple sequence)."; return 1
  fi
  if [[ ${#n} -ge 3 && $lp == *"$n"* ]]; then PASS_ERR="Password must not contain the username."; return 1; fi
  core="${lp//[^a-z]/}"
  for w in password passw0rd qwerty qwertyuiop letmein welcome admin administrator changeme iloveyou vpn secret login master monkey dragon football baseball; do
    if [[ $core == "$w" && ${#lp} -le $(( ${#w} + 6 )) ]]; then PASS_ERR="Password is too common."; return 1; fi
  done
  return 0
}

gen_pass() { openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | cut -c1-16; }
gen_strong_pass() { # NAME : a generated password that also satisfies pass_check
  local i p
  for i in 1 2 3 4 5 6 7 8; do p=$(gen_pass); pass_check "$1" "$p" && { printf '%s' "$p"; return 0; }; done
  printf '%s' "$p"
}

kick_user() {
  [[ $TESTMODE == 1 ]] && return 0
  python3 "$OPT/ikev2lib.py" kick "$1" >/dev/null 2>&1 || true
}

# ------------------------------------------------------------ swanctl.conf
# snip NAME INDENT : print custom raw snippet (if any) indented
snip() {
  local f="$ETC/custom/$1.conf"
  [[ -s $f ]] || return 0
  sed "s/^/$2/" "$f"
}
# opt INDENT KEY VALUE : print "KEY = VALUE" only when VALUE is not empty
opt() { [[ -n $3 ]] && printf '%s%s = %s\n' "$1" "$2" "$3"; return 0; }

rebuild_conf() {
  cfg_load; users_ensure
  [[ -n $SERVER_NAME ]] || die "Server is not configured yet (run the installer)."
  local new="$SWAN/swanctl.conf.new" cur="$SWAN/swanctl.conf" out lts="$LOCAL_TS"
  mkdir -p "$SWAN"
  # optional: also route ::/0 into the tunnel (the server forwards no IPv6, so it is black-holed instead of leaking)
  if [[ $IPV6_BLOCK == yes && ,$LOCAL_TS, == *,0.0.0.0/0,* ]]; then lts="$LOCAL_TS,::/0"; fi
  {
    cat <<EOF
# Generated by ikev2-manager v$VERSION - do not edit by hand.
# Use 'vpn' (menu) or 'vpn set KEY VALUE' / 'vpn raw edit NAME'.
connections {
  rw {
    version = 2
    pools = rw_pool
    send_cert = $SEND_CERT
    send_certreq = no
    fragmentation = $FRAGMENTATION
    mobike = $MOBIKE
    dpd_delay = $DPD_DELAY
    unique = $UNIQUE
$(opt '    ' rekey_time "$REKEY_TIME")
$(opt '    ' reauth_time "$REAUTH_TIME")
    proposals = $IKE_PROPOSALS
$(snip connection '    ')
    local {
      auth = pubkey
      certs = server.pem
      id = $SERVER_NAME
$(snip local '      ')
    }
    remote {
      auth = eap-mschapv2
      eap_id = %any
$(snip remote '      ')
    }
    children {
      net {
        local_ts = $lts
        esp_proposals = $ESP_PROPOSALS
$(opt '        ' rekey_time "$CHILD_REKEY_TIME")
$(opt '        ' life_time "$CHILD_LIFE_TIME")
$(snip child '        ')
      }
    }
  }
}
pools {
  rw_pool {
    addrs = $POOL
    dns = $DNS
$(snip pools '    ')
  }
}
secrets {
EOF
    # only well-formed lines become secrets (no regex intervals: mawk 1.3.4-2020 does not support them)
    awk -F: 'NF==4 && $3=="enabled" && length($1)<=32 && $1 ~ /^[A-Za-z0-9][A-Za-z0-9_.-]*$/ &&
             length($2)>=8 && length($2)<=64 && $2 ~ /^[A-Za-z0-9._@+=,!%^*~-]+$/ {
      n++; printf "  eap-%d {\n    id = %s\n    secret = \"%s\"\n  }\n", n, $1, $2 }' "$USERS"
    echo "}"
    snip extra ''
  } | sed '/^[[:space:]]*$/d' >"$new"
  chmod 600 "$new"
  [[ -f $cur ]] && { cp -f "$cur" "$cur.bak"; chmod 600 "$cur.bak"; }
  mv -f "$new" "$cur"
  if [[ $TESTMODE == 1 ]]; then
    # test hook: pretend swanctl rejects any config containing $IKEV2_TEST_FAIL
    if [[ -n ${IKEV2_TEST_FAIL:-} ]] && grep -q -- "$IKEV2_TEST_FAIL" "$cur"; then
      err "swanctl --load-all failed: (simulated) $IKEV2_TEST_FAIL"
      [[ -f $cur.bak ]] && cp -f "$cur.bak" "$cur"
      return 1
    fi
  elif ! out=$(run_swanctl --load-all); then
    err "swanctl --load-all failed:"; printf '%s\n' "$out" >&2
    [[ -f $cur.bak ]] && { cp -f "$cur.bak" "$cur"; run_swanctl --load-all >/dev/null; warn "Previous config restored."; }
    return 1
  fi
  return 0
}

# ------------------------------------------------------------ user commands
cmd_user_list() {
  users_ensure
  if [[ ${1:-} == --plain ]]; then
    awk -F: '{printf "%s|%s|%s\n", $1, $3, $4}' "$USERS"
    return
  fi
  if [[ $(user_count) -eq 0 ]]; then say "No users yet. Add one: vpn user add NAME"; return; fi
  printf '%-20s %-9s %-11s %-18s %s\n' USER STATUS CREATED USAGE EXPIRES
  local n p s cr d qn qu ql qe qs
  local -A QS=()
  while IFS='|' read -r qn qu ql qe qs; do QS[$qn]="$qu / $ql|$qe"; done \
    < <(python3 "$OPT/ikev2lib.py" quota list --short 2>/dev/null)
  while IFS=: read -r n p s cr; do
    [[ $cr =~ ^[0-9]+$ ]] && d=$(date -d "@$cr" +%F 2>/dev/null) || d="-"
    printf '%-20s %-9s %-11s %-18s %s\n' "$n" "$s" "$d" "${QS[$n]%%|*}" "${QS[$n]#*|}"
  done <"$USERS"
}

cmd_user_add() { need_root; locked _user_add "$@"; }
_user_add() {
  local name="${1:-}" pass="" plain=0 stdin=0 snap qlimit="" qdays="" qexp="" qact="default" lim_b exp_e
  [[ -n $name ]] || die "Usage: vpn user add NAME [PASSWORD | --stdin] [--plain] [--limit SIZE] [--days N | --expires YYYY-MM-DD] [--action default|disable|delete|notify]"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plain) plain=1 ;;
      --stdin) stdin=1 ;;
      --limit|--days|--expires|--action)
        [[ $# -ge 2 ]] || die "$1 needs a value"
        case "$1" in --limit) qlimit="$2" ;; --days) qdays="$2" ;; --expires) qexp="$2" ;; --action) qact="$2" ;; esac
        shift ;;
      *) pass="$1" ;;
    esac
    shift
  done
  [[ $stdin == 1 ]] && { IFS= read -r pass || true; }
  [[ $name =~ $NAME_RE ]] || die "Invalid username. Use letters, digits, '_', '.', '-' (max 32 chars)."
  users_ensure; cfg_load
  user_exists "$name" && die "User '$name' already exists."
  # traffic limit / expiry (validated BEFORE anything is created); empty = the defaults from 'vpn get'
  [[ -n $qlimit ]] || qlimit="${DEFAULT_LIMIT:-0}"
  lim_b=$(python3 "$OPT/ikev2lib.py" quota parse-size "$qlimit" 2>&1) || die "$lim_b"
  if [[ -n $qexp ]]; then exp_e=$(python3 "$OPT/ikev2lib.py" quota parse-expiry "$qexp" 2>&1) || die "$exp_e"
  else exp_e=$(python3 "$OPT/ikev2lib.py" quota parse-expiry "${qdays:-${DEFAULT_DAYS:-never}}" 2>&1) || die "$exp_e"; fi
  (( exp_e == 0 || exp_e > $(date +%s) )) || die "The expiry date is in the past."
  [[ $qact =~ ^(default|disable|delete|notify)$ ]] || die "--action must be one of: default, disable, delete, notify"
  [[ -n $pass ]] || pass=$(gen_strong_pass "$name")
  pass_check "$name" "$pass" || die "$PASS_ERR"
  snap=$(users_snapshot) || die "Could not snapshot users.db"
  printf '%s:%s:enabled:%s\n' "$name" "$pass" "$(date +%s)" >>"$USERS"
  if ! rebuild_conf; then
    users_restore "$snap"
    die "Could not apply the configuration - the user was NOT created. See: vpn logs"
  fi
  users_discard "$snap"
  python3 "$OPT/ikev2lib.py" quota init "$name" "$lim_b" "$exp_e" "$qact" >/dev/null 2>&1 \
    || warn "Could not store the traffic limit / expiry (set it with: vpn quota set $name ...)"
  log "user added: $name (limit=$lim_b expires=$exp_e action=$qact)"
  if [[ $plain == 1 ]]; then printf '%s\n' "$pass"; else
    ok "User created."; say "  Username: $name"; say "  Password: $pass"
    if (( lim_b > 0 )); then say "  Traffic:  $(python3 "$OPT/ikev2lib.py" quota show "$name" | sed 's/^[^:]*: //; s/, when over.*//')"; fi
  fi
}

cmd_user_del() { need_root; locked _user_del "$@"; }
_user_del() {
  local name="${1:-}" snap
  [[ -n $name ]] || die "Usage: vpn user del NAME"
  user_exists "$name" || die "No such user: $name"
  snap=$(users_snapshot) || die "Could not snapshot users.db"
  user_remove "$name" || { users_restore "$snap"; die "Could not update users.db"; }
  if ! rebuild_conf; then
    users_restore "$snap"
    die "Could not apply the configuration - user '$name' was NOT deleted and is STILL ACTIVE. Fix the error above (vpn logs / vpn raw) and retry."
  fi
  users_discard "$snap"
  python3 "$OPT/ikev2lib.py" quota forget "$name" >/dev/null 2>&1 || true
  kick_user "$name"
  log "user deleted: $name"; ok "User '$name' deleted."
}

cmd_user_setstatus() { need_root; locked _user_setstatus "$@"; }
_user_setstatus() {
  local name="${1:-}" st="$2" snap
  [[ -n $name ]] || die "Usage: vpn user enable|disable NAME"
  user_exists "$name" || die "No such user: $name"
  if [[ $st == enabled ]] && ! python3 "$OPT/ikev2lib.py" quota show "$name" --kv 2>/dev/null | grep -q '^label=ok$'; then
    warn "'$name' is over its traffic limit or expired - it will be disabled again within a minute unless you renew it: vpn quota add/set/reset $name"
  fi
  snap=$(users_snapshot) || die "Could not snapshot users.db"
  user_set "$name" 3 "$st" || { users_restore "$snap"; die "Could not update users.db"; }
  if ! rebuild_conf; then
    users_restore "$snap"
    die "Could not apply the configuration - user '$name' was NOT changed (still $([[ $st == disabled ]] && echo ACTIVE || echo disabled)). Fix the error above (vpn logs / vpn raw) and retry."
  fi
  users_discard "$snap"
  [[ $st == disabled ]] && kick_user "$name"
  log "user $name -> $st"; ok "User '$name' is now $st."
}

cmd_user_passwd() { need_root; locked _user_passwd "$@"; }
_user_passwd() {
  local name="${1:-}" pass="" plain=0 stdin=0 a snap
  [[ -n $name ]] || die "Usage: vpn user passwd NAME [PASSWORD | auto | --stdin] [--plain]"
  shift
  for a in "$@"; do case "$a" in --plain) plain=1 ;; --stdin) stdin=1 ;; *) pass="$a" ;; esac; done
  [[ $stdin == 1 ]] && { IFS= read -r pass || true; }
  user_exists "$name" || die "No such user: $name"
  [[ -n $pass && $pass != auto ]] || pass=$(gen_strong_pass "$name")
  pass_check "$name" "$pass" || die "$PASS_ERR"
  snap=$(users_snapshot) || die "Could not snapshot users.db"
  user_set "$name" 2 "$pass" || { users_restore "$snap"; die "Could not update users.db"; }
  if ! rebuild_conf; then
    users_restore "$snap"
    die "Could not apply the configuration - the password of '$name' was NOT changed. See: vpn logs"
  fi
  users_discard "$snap"
  kick_user "$name"
  log "password changed: $name"
  if [[ $plain == 1 ]]; then printf '%s\n' "$pass"; else ok "Password changed."; say "  New password: $pass"; fi
}

cmd_user_show() {
  local name="${1:-}"
  [[ -n $name ]] || die "Usage: vpn user show NAME"
  user_exists "$name" || die "No such user: $name"
  cfg_load
  say "Server:   $SERVER_NAME"
  say "Username: $name"
  say "Password: $(user_get "$name" 2)"
  say "Status:   $(user_get "$name" 3)"
  say "Type:     IKEv2 (EAP-MSCHAPv2)"
  python3 "$OPT/ikev2lib.py" quota show "$name" 2>/dev/null | sed 's/^[^:]*: /Quota:    /'
}

cmd_user() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list|ls)          cmd_user_list "$@" ;;
    add)              cmd_user_add "$@" ;;
    del|rm|delete)    cmd_user_del "$@" ;;
    enable)           cmd_user_setstatus "${1:-}" enabled ;;
    disable)          cmd_user_setstatus "${1:-}" disabled ;;
    passwd|password)  cmd_user_passwd "$@" ;;
    show)             cmd_user_show "$@" ;;
    *) die "Usage: vpn user list|add|del|enable|disable|passwd|show" ;;
  esac
}

# ------------------------------------------------------------ traffic limit + expiry
# Usage is counted by `vpn quota tick` (run every 20 s by ikev2-quota.timer): strongSwan only reports counters of live
# sessions, so the tick adds the difference since the previous one. Enforcement therefore lags by up to ~20 s.
qpy() { python3 "$OPT/ikev2lib.py" quota "$@"; }

cmd_quota() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|ls)  users_ensure; qpy list "$@" ;;
    show)     [[ -n ${1:-} ]] || die "Usage: vpn quota show NAME"; qpy show "$@" || return 1 ;;
    set|add|reset|tick) locked _quota "$sub" "$@" ;;
    *) die "Usage: vpn quota list | show NAME | set NAME [--limit SIZE] [--days N | --expires DATE] [--action A] | add NAME [--limit SIZE] [--days N] | reset NAME" ;;
  esac
}

_quota() {
  local sub="$1" out; shift
  cfg_load; users_ensure
  case "$sub" in
    tick)
      out=$(qpy tick --action "$QUOTA_ACTION" "$@" 2>&1) || { err "quota tick failed: $out"; return 1; }
      _quota_apply "$out" ;;
    set|add|reset)
      [[ -n ${1:-} ]] || die "Usage: vpn quota $sub NAME ..."
      out=$(qpy "$sub" "$@" 2>&1) || die "$out"
      say "$out"; log "quota $sub $*"
      # a lower limit may disable the user right now; a renewal re-enables a user the quota had disabled
      out=$(qpy tick --action "$QUOTA_ACTION" --no-measure 2>&1) || { err "quota enforcement failed: $out"; return 1; }
      _quota_apply "$out" ;;
  esac
}

_quota_apply() { # ACTION NAME REASON per line, as printed by `quota tick`
  local line act name why
  while IFS= read -r line; do
    [[ -n $line ]] || continue
    read -r act name why <<<"$line"
    [[ $name =~ $NAME_RE ]] || continue
    case "$act" in
      disable) if ( _user_setstatus "$name" disabled ) >/dev/null 2>&1; then log "quota: $name disabled ($why)"; say "User '$name' disabled ($why)."
               else warn "Could not disable '$name' - will retry on the next check"; fi ;;
      enable)  if ( _user_setstatus "$name" enabled ) >/dev/null 2>&1; then log "quota: $name enabled again ($why)"; say "User '$name' enabled again."
               else warn "Could not re-enable '$name'"; fi ;;
      delete)  if ( _user_del "$name" ) >/dev/null 2>&1; then log "quota: $name deleted ($why)"; say "User '$name' deleted ($why)."
               else warn "Could not delete '$name' - will retry on the next check"; fi ;;
    esac
  done <<<"$1"
}

# ------------------------------------------------------------ PKI / certificates
pki_init_ca() {
  cfg_load
  mkdir -p "$PKI"; chmod 700 "$PKI"
  if [[ ! -f $PKI/ca.key || ! -f $PKI/ca.pem ]]; then
    (
      umask 077
      pki --gen --type rsa --size 3072 --outform pem >"$PKI/ca.key"
    ) || die "pki --gen failed (is strongswan-pki installed?)"
    chmod 600 "$PKI/ca.key"
    # pathlen 0: this CA may only sign end-entity certificates, never another CA.
    # (older pki builds that do not know --pathlen fall back to the previous behaviour)
    if ! pki --self --ca --pathlen 0 --lifetime 3652 --in "$PKI/ca.key" --dn "CN=$CA_CN" --outform pem >"$PKI/ca.pem" 2>/dev/null; then
      warn "pki rejected --pathlen; creating the CA without a path-length constraint."
      pki --self --ca --lifetime 3652 --in "$PKI/ca.key" --dn "CN=$CA_CN" --outform pem >"$PKI/ca.pem" \
        || die "pki --self failed"
    fi
    chmod 644 "$PKI/ca.pem"
  fi
}

# issue server cert for NAME (IP or domain) signed by our CA
pki_issue_server() {
  local name="$1" t
  t=$(mktemp -d) || die "mktemp failed"
  chmod 700 "$t"
  if ! (
    umask 077
    pki --gen --type rsa --size 3072 --outform pem >"$t/key.pem" &&
    pki --req --type priv --in "$t/key.pem" --dn "CN=$name" --san "$name" --outform pem >"$t/req.pem" &&
    pki --issue --cacert "$PKI/ca.pem" --cakey "$PKI/ca.key" --type pkcs10 --in "$t/req.pem" \
        --lifetime 1826 --flag serverAuth --flag ikeIntermediate --outform pem >"$t/cert.pem"
  ); then
    rm -rf "$t"; die "certificate generation failed (is strongswan-pki installed?)"
  fi
  mkdir -p "$SWAN/x509" "$SWAN/x509ca" "$SWAN/private"
  install -m 644 "$t/cert.pem" "$SWAN/x509/server.pem"
  install -m 600 "$t/key.pem"  "$SWAN/private/server.key"
  install -m 644 "$PKI/ca.pem" "$SWAN/x509ca/ikev2-ca.pem"
  rm -rf "$t"
}

# whole days until the server certificate expires (floor; NEGATIVE once it has expired); "none" when absent/unreadable
cert_days_left() {
  local f="$SWAN/x509/server.pem" end e r
  [[ -f $f ]] || { echo none; return; }
  end=$(openssl x509 -enddate -noout -in "$f" 2>/dev/null | cut -d= -f2)
  [[ -n $end ]] || { echo none; return; }
  e=$(date -d "$end" +%s 2>/dev/null) || { echo none; return; }
  r=$(( e - $(date +%s) ))
  if (( r >= 0 )); then echo $(( r / 86400 )); else echo $(( -( (-r + 86399) / 86400 ) )); fi
}

# ok | expiring (<= 14 days) | expired | missing
cert_state() {
  local d; d=$(cert_days_left)
  if [[ $d == none ]]; then echo missing
  elif (( d < 0 )); then echo expired
  elif (( d <= 14 )); then echo expiring
  else echo ok; fi
}

ca_der_b64() { openssl x509 -in "$PKI/ca.pem" -outform DER | base64 -w0; }

