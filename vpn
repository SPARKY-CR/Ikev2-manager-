      0|"") ui_clear; return ;;
    esac
  done
}

# ------------------------------------------------------------ help / main
cmd_help() {
  cat <<EOF
IKEv2 Manager v$VERSION  -  run 'sudo vpn' for the text menu

Users
  vpn user list | add NAME [PASS|--stdin] [--limit 10G] [--days 30] | del NAME | enable NAME | disable NAME
  vpn user passwd NAME [PASS|auto|--stdin] | show NAME      (passwords: 12+ chars; --stdin keeps them out of ps)
  vpn profile NAME [DIR]       write .sswan / .mobileconfig / windows script
  vpn zed NAME [--nopw]        ZedSecure import link (zedsecure://...)
  vpn ca                       print CA certificate (IP mode)
Traffic limit + expiry (checked every 20 s by ikev2-quota.timer)
  vpn quota list | show NAME            usage, limit, expiry, state
  vpn quota set NAME [--limit 10G|unlimited] [--days 30 | --expires 2026-12-31 | --days never]
                     [--action default|disable|delete|notify]
  vpn quota add NAME [--limit 5G] [--days 30]   extend (renews a user that the quota disabled)
  vpn quota reset NAME                  usage back to 0 (renews a disabled user)
  new-user defaults / global action:    vpn set DEFAULT_LIMIT 20G | DEFAULT_DAYS 30 | QUOTA_ACTION disable|delete|notify
Server
  vpn status | online | restart | logs [N]
  vpn cert info|renew|auto     vpn domain set DOMAIN [EMAIL] | unset
  vpn ip refresh               vpn upgrade-strongswan
Advanced strongSwan settings
  vpn get [KEY]                list settings (DNS, pool, routes, proposals, timers, ...)
  vpn set KEY VALUE            change one (VALUE "default" resets), applied + validated
  vpn preset dns cloudflare|google|quad9|adguard|cloudflare-family|opendns|list
  vpn preset ike compat|strict-sha2     vpn reset [--yes]
  security knobs: CLIENT_ISOLATION, BLOCK_PRIVATE, IKE_RATE_LIMIT, IPV6_BLOCK  (see: vpn get)
  vpn raw list|show|edit|set|clear NAME  add ANY strongSwan option (connection, local,
                               remote, child, pools, extra, charon)
  vpn conf show|apply          view / regenerate the final swanctl.conf
Security
  vpn fw on|off|status|ports "22 2222"     vpn security fail2ban|autoupdate
Bot
  vpn bot setup TOKEN|- ADMIN_ID | on | off | status | test | logs   ('-' reads the token from stdin)
Maintenance
  vpn backup [--encrypt] | backups | restore FILE [--key PRIVATE_KEY.pem]
  vpn backup key init|set CERT.pem|show|remove    vpn backup decrypt FILE.enc KEY.pem [OUT]
  vpn update [--check] [--yes] [--force]     download + verify (checksums, signature) + install
  vpn update --base https://RAW_URL --save-only   set the update source (https only)
  vpn update FOLDER                          update from a local repo folder
  vpn uninstall [--purge] [--yes]
  vpn version
EOF
}

main() {
  local cmd="${1:-}"; shift || true
  case "$cmd" in
    ""|help|-h|--help|version|-v|--version) ;;
    *) need_root ;;
  esac
  case "$cmd" in
    "")                 tui_main ;;
    help|-h|--help)     cmd_help ;;
    version|-v|--version) say "ikev2-manager $VERSION" ;;
    status)             cmd_status "$@" ;;
    online)             cmd_online ;;
    user)               cmd_user "$@" ;;
    quota)              cmd_quota "$@" ;;
    profile)            cmd_profile "$@" ;;
    ca)                 cmd_ca ;;
    zed)                cmd_zed "$@" ;;
    restart)            cmd_restart ;;
    logs)               cmd_logs "$@" ;;
    cert)               cmd_cert "$@" ;;
    domain)             cmd_domain "$@" ;;
    ip)                 cmd_ip "$@" ;;
    upgrade-strongswan) cmd_upgrade_strongswan ;;
    fw)                 cmd_fw "$@" ;;
    security)           cmd_security "$@" ;;
    bot)                cmd_bot "$@" ;;
    backup)             cmd_backup "$@" ;;
    backups)            cmd_backups ;;
    restore)            cmd_restore "$@" ;;
    update)             cmd_update "$@" ;;
    get)                cmd_get "$@" ;;
    set)                cmd_set "$@" ;;
    reset)              cmd_reset "$@" ;;
    preset)             cmd_preset "$@" ;;
    raw)                cmd_raw "$@" ;;
    conf)               cmd_conf "$@" ;;
    uninstall)          cmd_uninstall "$@" ;;
    net)                if [[ ${1:-} == apply ]]; then net_apply; else die "Usage: vpn net apply"; fi ;;
    setup)              cmd_setup "$@" ;;
    migrate)            cmd_migrate ;;
    selftest)           cmd_selftest ;;
    *) err "Unknown command: $cmd"; cmd_help; exit 1 ;;
  esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then main "$@"; fi
