#!/usr/bin/env bash
# vpn - IKEv2 (strongSwan) manager: CLI + TUI
# Part of ikev2-manager.
set -uo pipefail

ETC="${IKEV2_ETC:-/etc/ikev2}"
VAR="${IKEV2_VAR:-/var/lib/ikev2}"
OPT="${IKEV2_OPT:-/opt/ikev2}"
SWAN="${IKEV2_SWAN:-/etc/swanctl}"
BACKUPS="${IKEV2_BACKUPS:-/var/backups/ikev2}"
EXPORTS="${IKEV2_EXPORTS:-/root/ikev2-profiles}"
CONF="$ETC/config.env"
USERS="$ETC/users.db"
PKI="$ETC/pki"
LOGFILE="${IKEV2_LOG:-/var/log/ikev2-manager.log}"
VERSION="$(cat "$OPT/VERSION" 2>/dev/null || echo dev)"
TESTMODE="${IKEV2_TEST:-0}"
SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"


# ---- defaults for every tunable setting (empty value in config.env = default)
D_POOL='10.30.0.0/16'
D_DNS='1.1.1.1,8.8.8.8'
D_LOCAL_TS='0.0.0.0/0'
D_IKE_PROPOSALS='default,aes256-sha256-modp2048,aes128-sha256-modp2048,aes256-sha1-modp2048,aes128-sha1-modp2048'
D_ESP_PROPOSALS='default,aes256-sha256-modp2048,aes128-sha256-modp2048,aes256-sha256,aes128-sha256,aes256gcm16,aes128gcm16'
D_DPD_DELAY='30s'
D_FRAGMENTATION='yes'
D_MOBIKE='yes'
D_UNIQUE='no'
D_SEND_CERT='always'
D_MSS_CLAMP='pmtu'
D_NAT='yes'
D_LOG_LEVEL='default'

NAME_RE='^[A-Za-z0-9][A-Za-z0-9_.-]{0,31}$'
PASS_RE='^[A-Za-z0-9._@+=,!%^*~-]{8,64}$'

# ------------------------------------------------------------ output helpers
c()    { if [[ -t 1 ]]; then printf '\e[%sm' "$1"; fi; }
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s%s%s\n' "$(c 32)" "$*" "$(c 0)"; }
warn() { printf '%s%s%s\n' "$(c 33)" "$*" "$(c 0)" >&2; }
err()  { printf '%s%s%s\n' "$(c 31)" "Error: $*" "$(c 0)" >&2; }
die()  { err "$*"; exit 1; }
step() { printf '%s==>%s %s\n' "$(c 36)" "$(c 0)" "$*"; log "STEP $*"; }
log()  { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOGFILE" 2>/dev/null || true; }

need_root() {
  [[ $TESTMODE == 1 || $EUID -eq 0 ]] || die "Run as root: sudo vpn"
}

# ------------------------------------------------------------ system wrappers
run_swanctl() {
  [[ $TESTMODE == 1 ]] && return 0
  local out rc
  out=$(swanctl "$@" 2>&1); rc=$?
  printf '%s\n' "$out" | grep -Ev "^plugin '|CAP_SETUID|^$" || true
  return $rc
}

svc_name() {
  local u
  for u in strongswan-swanctl strongswan; do
    if systemctl cat "$u.service" 2>/dev/null | grep -q charon-systemd; then
      echo "$u"; return
    fi
  done
  echo strongswan
}

svc_active() {
  [[ $TESTMODE == 1 ]] && { echo active; return; }
  systemctl is-active "$(svc_name)" 2>/dev/null || true
}

svc_restart() {
  [[ $TESTMODE == 1 ]] && return 0
  systemctl restart "$(svc_name)"
}

apt_install() {
  [[ $TESTMODE == 1 ]] && return 0
  export DEBIAN_FRONTEND=noninteractive
  if ! apt-get install -y "$@" >>"$LOGFILE" 2>&1; then
    tail -n 15 "$LOGFILE" >&2
    die "apt-get install failed: $*"
  fi
}

# ------------------------------------------------------------ config
cfg_load() {
  MODE=""; SERVER_NAME=""; SERVER_IP=""; IFACE=""; DOMAIN=""; CA_CN=""; BOT_TOKEN=""; ADMIN_ID=""
  EMAIL=""; FIREWALL=""; FW_SSH_PORTS=""; UPDATE_BASE=""
  POOL=""; DNS=""; LOCAL_TS=""; IKE_PROPOSALS=""; ESP_PROPOSALS=""; DPD_DELAY=""; FRAGMENTATION=""
  MOBIKE=""; UNIQUE=""; REKEY_TIME=""; REAUTH_TIME=""; CHILD_REKEY_TIME=""; CHILD_LIFE_TIME=""
  SEND_CERT=""; MSS_CLAMP=""; NAT=""; FW_EXTRA_TCP=""; FW_EXTRA_UDP=""; LOG_LEVEL=""
  [[ -f $CONF ]] && . "$CONF"
  : "${MODE:=ip}" "${CA_CN:=IKEv2 VPN CA}" "${FIREWALL:=no}" "${FW_SSH_PORTS:=22}"
  : "${POOL:=$D_POOL}" "${DNS:=$D_DNS}" "${LOCAL_TS:=$D_LOCAL_TS}" "${IKE_PROPOSALS:=$D_IKE_PROPOSALS}"
  : "${ESP_PROPOSALS:=$D_ESP_PROPOSALS}" "${DPD_DELAY:=$D_DPD_DELAY}" "${FRAGMENTATION:=$D_FRAGMENTATION}"
  : "${MOBIKE:=$D_MOBIKE}" "${UNIQUE:=$D_UNIQUE}" "${SEND_CERT:=$D_SEND_CERT}" "${MSS_CLAMP:=$D_MSS_CLAMP}"
  : "${NAT:=$D_NAT}" "${LOG_LEVEL:=$D_LOG_LEVEL}"
}

cfg_set() {
  local k="$1" v="$2" t
  mkdir -p "$ETC"; touch "$CONF"; chmod 600 "$CONF"
  t=$(mktemp)
  grep -v "^${k}=" "$CONF" >"$t" || true
  printf "%s='%s'\n" "$k" "${v//\'/\'\\\'\'}" >>"$t"
  cat "$t" >"$CONF"; rm -f "$t"
}

# ------------------------------------------------------------ users db
# format: name:password:status:created_epoch
users_ensure() { mkdir -p "$ETC"; [[ -f $USERS ]] || : >"$USERS"; chmod 600 "$USERS"; }
user_exists()  { [[ -f $USERS ]] && awk -F: -v n="$1" '$1==n{f=1} END{exit !f}' "$USERS"; }
user_get()     { awk -F: -v n="$1" -v f="$2" '$1==n{print $f; exit}' "$USERS"; }
user_count()   { [[ -f $USERS ]] && awk 'END{print NR}' "$USERS" || echo 0; }
user_enabled_count() { [[ -f $USERS ]] && awk -F: '$3=="enabled"{n++} END{print n+0}' "$USERS" || echo 0; }

user_set() {
  local n="$1" f="$2" v="$3" t
  t=$(mktemp)
  awk -F: -v OFS=: -v n="$n" -v f="$f" -v v="$v" '$1==n{$f=v}1' "$USERS" >"$t"
  cat "$t" >"$USERS"; rm -f "$t"
}

user_remove() {
  local t; t=$(mktemp)
  awk -F: -v n="$1" '$1!=n' "$USERS" >"$t"
  cat "$t" >"$USERS"; rm -f "$t"
}

gen_pass() { openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | cut -c1-16; }

kick_user() {
  [[ $TESTMODE == 1 ]] && return 0
  python3 "$OPT/ikev2lib.py" kick "$1" >/dev/null 2>&1 || true
}

# ------------------------------------------------------------ swanctl.conf
# snip NAME INDENT : print custom raw snippet (if any) indented
snip() {
  local f="$ETC/custom/$1.conf"
  [[ -s $f ]] || return 0
  sed "s/^/$2/" "$f"
}
# opt INDENT KEY VALUE : print "KEY = VALUE" only when VALUE is not empty
opt() { [[ -n $3 ]] && printf '%s%s = %s\n' "$1" "$2" "$3"; return 0; }

rebuild_conf() {
  cfg_load; users_ensure
  [[ -n $SERVER_NAME ]] || die "Server is not configured yet (run the installer)."
  local new="$SWAN/swanctl.conf.new" cur="$SWAN/swanctl.conf" out
  mkdir -p "$SWAN"
  {
    cat <<EOF
# Generated by ikev2-manager v$VERSION - do not edit by hand.
# Use 'vpn' (menu) or 'vpn set KEY VALUE' / 'vpn raw edit NAME'.
connections {
  rw {
    version = 2
    pools = rw_pool
    send_cert = $SEND_CERT
    send_certreq = no
    fragmentation = $FRAGMENTATION
    mobike = $MOBIKE
    dpd_delay = $DPD_DELAY
    unique = $UNIQUE
$(opt '    ' rekey_time "$REKEY_TIME")
$(opt '    ' reauth_time "$REAUTH_TIME")
    proposals = $IKE_PROPOSALS
$(snip connection '    ')
    local {
      auth = pubkey
      certs = server.pem
      id = $SERVER_NAME
$(snip local '      ')
    }
    remote {
      auth = eap-mschapv2
      eap_id = %any
$(snip remote '      ')
    }
    children {
      net {
        local_ts = $LOCAL_TS
        esp_proposals = $ESP_PROPOSALS
$(opt '        ' rekey_time "$CHILD_REKEY_TIME")
$(opt '        ' life_time "$CHILD_LIFE_TIME")
$(snip child '        ')
      }
    }
  }
}
pools {
  rw_pool {
    addrs = $POOL
    dns = $DNS
$(snip pools '    ')
  }
}
secrets {
EOF
    awk -F: '$3=="enabled"{n++; printf "  eap-%d {\n    id = %s\n    secret = \"%s\"\n  }\n", n, $1, $2}' "$USERS"
    echo "}"
    snip extra ''
  } | sed '/^[[:space:]]*$/d' >"$new"
  chmod 600 "$new"
  [[ -f $cur ]] && cp -f "$cur" "$cur.bak"
  mv -f "$new" "$cur"
  if [[ $TESTMODE == 1 ]]; then
    # test hook: pretend swanctl rejects any config containing $IKEV2_TEST_FAIL
    if [[ -n ${IKEV2_TEST_FAIL:-} ]] && grep -q -- "$IKEV2_TEST_FAIL" "$cur"; then
      err "swanctl --load-all failed: (simulated) $IKEV2_TEST_FAIL"
      [[ -f $cur.bak ]] && cp -f "$cur.bak" "$cur"
      return 1
    fi
  elif ! out=$(run_swanctl --load-all); then
    err "swanctl --load-all failed:"; printf '%s\n' "$out" >&2
    [[ -f $cur.bak ]] && { cp -f "$cur.bak" "$cur"; run_swanctl --load-all >/dev/null; warn "Previous config restored."; }
    return 1
  fi
  return 0
}

# ------------------------------------------------------------ user commands
cmd_user_list() {
  users_ensure
  if [[ ${1:-} == --plain ]]; then
    awk -F: '{printf "%s|%s|%s\n", $1, $3, $4}' "$USERS"
    return
  fi
  if [[ $(user_count) -eq 0 ]]; then say "No users yet. Add one: vpn user add NAME"; return; fi
  printf '%-20s %-9s %s\n' USER STATUS CREATED
  awk -F: '{cmd="date -d @" $4 " +%F"; cmd | getline d; close(cmd); printf "%-20s %-9s %s\n", $1, $3, d}' "$USERS"
}

cmd_user_add() {
  need_root
  local name="${1:-}" pass="" plain=0 a
  [[ -n $name ]] || die "Usage: vpn user add NAME [PASSWORD]"
  shift
  for a in "$@"; do case "$a" in --plain) plain=1 ;; *) pass="$a" ;; esac; done
  [[ $name =~ $NAME_RE ]] || die "Invalid username. Use letters, digits, '_', '.', '-' (max 32 chars)."
  users_ensure
  user_exists "$name" && die "User '$name' already exists."
  [[ -n $pass ]] || pass=$(gen_pass)
  [[ $pass =~ $PASS_RE ]] || die "Invalid password. Use 8-64 chars: letters, digits and . _ @ + = , ! % ^ * ~ -"
  printf '%s:%s:enabled:%s\n' "$name" "$pass" "$(date +%s)" >>"$USERS"
  rebuild_conf || die "Could not apply configuration."
  log "user added: $name"
  if [[ $plain == 1 ]]; then printf '%s\n' "$pass"; else
    ok "User created."; say "  Username: $name"; say "  Password: $pass"
  fi
}

cmd_user_del() {
  need_root
  local name="${1:-}"
  [[ -n $name ]] || die "Usage: vpn user del NAME"
  user_exists "$name" || die "No such user: $name"
  user_remove "$name"; rebuild_conf; kick_user "$name"
  log "user deleted: $name"; ok "User '$name' deleted."
}

cmd_user_setstatus() {
  need_root
  local name="${1:-}" st="$2"
  [[ -n $name ]] || die "Usage: vpn user enable|disable NAME"
  user_exists "$name" || die "No such user: $name"
  user_set "$name" 3 "$st"; rebuild_conf
  [[ $st == disabled ]] && kick_user "$name"
  log "user $name -> $st"; ok "User '$name' is now $st."
}

cmd_user_passwd() {
  need_root
  local name="${1:-}" pass="" plain=0 a
  [[ -n $name ]] || die "Usage: vpn user passwd NAME [PASSWORD]"
  shift
  for a in "$@"; do case "$a" in --plain) plain=1 ;; *) pass="$a" ;; esac; done
  user_exists "$name" || die "No such user: $name"
  [[ -n $pass && $pass != auto ]] || pass=$(gen_pass)
  [[ $pass =~ $PASS_RE ]] || die "Invalid password. Use 8-64 chars: letters, digits and . _ @ + = , ! % ^ * ~ -"
  user_set "$name" 2 "$pass"; rebuild_conf; kick_user "$name"
  log "password changed: $name"
  if [[ $plain == 1 ]]; then printf '%s\n' "$pass"; else ok "Password changed."; say "  New password: $pass"; fi
}

cmd_user_show() {
  local name="${1:-}"
  [[ -n $name ]] || die "Usage: vpn user show NAME"
  user_exists "$name" || die "No such user: $name"
  cfg_load
  say "Server:   $SERVER_NAME"
  say "Username: $name"
  say "Password: $(user_get "$name" 2)"
  say "Status:   $(user_get "$name" 3)"
  say "Type:     IKEv2 (EAP-MSCHAPv2)"
}

cmd_user() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list|ls)          cmd_user_list "$@" ;;
    add)              cmd_user_add "$@" ;;
    del|rm|delete)    cmd_user_del "$@" ;;
    enable)           cmd_user_setstatus "${1:-}" enabled ;;
    disable)          cmd_user_setstatus "${1:-}" disabled ;;
    passwd|password)  cmd_user_passwd "$@" ;;
    show)             cmd_user_show "$@" ;;
    *) die "Usage: vpn user list|add|del|enable|disable|passwd|show" ;;
  esac
}

# ------------------------------------------------------------ PKI / certificates
pki_init_ca() {
  cfg_load
  mkdir -p "$PKI"; chmod 700 "$PKI"
  if [[ ! -f $PKI/ca.key || ! -f $PKI/ca.pem ]]; then
    pki --gen --type rsa --size 3072 --outform pem >"$PKI/ca.key" || die "pki --gen failed (is strongswan-pki installed?)"
    chmod 600 "$PKI/ca.key"
    pki --self --ca --lifetime 3652 --in "$PKI/ca.key" --dn "CN=$CA_CN" --outform pem >"$PKI/ca.pem" \
      || die "pki --self failed"
    chmod 644 "$PKI/ca.pem"
  fi
}

# issue server cert for NAME (IP or domain) signed by our CA
pki_issue_server() {
  local name="$1" t
  t=$(mktemp -d)
  pki --gen --type rsa --size 3072 --outform pem >"$t/key.pem" || die "key generation failed"
  pki --req --type priv --in "$t/key.pem" --dn "CN=$name" --san "$name" --outform pem >"$t/req.pem" \
    || die "certificate request failed"
  pki --issue --cacert "$PKI/ca.pem" --cakey "$PKI/ca.key" --type pkcs10 --in "$t/req.pem" \
      --lifetime 1826 --flag serverAuth --flag ikeIntermediate --outform pem >"$t/cert.pem" \
    || die "certificate issue failed"
  mkdir -p "$SWAN/x509" "$SWAN/x509ca" "$SWAN/private"
  install -m 644 "$t/cert.pem" "$SWAN/x509/server.pem"
  install -m 600 "$t/key.pem"  "$SWAN/private/server.key"
  install -m 644 "$PKI/ca.pem" "$SWAN/x509ca/ikev2-ca.pem"
  rm -rf "$t"
}

cert_days_left() {
  local f="$SWAN/x509/server.pem" end
  [[ -f $f ]] || { echo -1; return; }
  end=$(openssl x509 -enddate -noout -in "$f" 2>/dev/null | cut -d= -f2)
  [[ -n $end ]] || { echo -1; return; }
  echo $(( ( $(date -d "$end" +%s) - $(date +%s) ) / 86400 ))
}

ca_der_b64() { openssl x509 -in "$PKI/ca.pem" -outform DER | base64 -w0; }

# ------------------------------------------------------------ client profiles
uuid4() { cat /proc/sys/kernel/random/uuid; }

gen_sswan() { # name pass
  local name="$1" cert_line="" id_line=""
  if [[ $MODE == ip ]]; then
    cert_line=",
    \"cert\": \"$(ca_der_b64)\""
  else
    id_line=",
    \"id\": \"$SERVER_NAME\""
  fi
  cat <<EOF
{
  "uuid": "$(uuid4)",
  "name": "VPN $SERVER_NAME ($name)",
  "type": "ikev2-eap",
  "remote": {
    "addr": "$SERVER_NAME"$id_line$cert_line
  },
  "local": {
    "eap_id": "$name"
  },
  "split-tunneling": {
    "block-ipv6": true
  }
}
EOF
}

