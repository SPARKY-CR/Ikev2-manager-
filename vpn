# ------------------------------------------------------------ certificates: IP / domain
dns_check() { # domain -> 0 ok, 1 mismatch, 2 no record
  local d="$1" ip
  ip=$(getent ahostsv4 "$d" 2>/dev/null | awk 'NR==1{print $1}')
  [[ -n $ip ]] || return 2
  [[ $ip == "$SERVER_IP" ]] || return 1
}

le_hooks() {
  mkdir -p "$ETC/hooks"
  cat >"$ETC/hooks/pre.sh" <<'EOF'
#!/bin/sh
# open port 80 for Let's Encrypt (HTTP-01)
for c in iptables ip6tables; do
  command -v $c >/dev/null 2>&1 || continue
  $c -C INPUT -p tcp --dport 80 -j ACCEPT 2>/dev/null || $c -I INPUT 1 -p tcp --dport 80 -j ACCEPT
done
exit 0
EOF
  cat >"$ETC/hooks/post.sh" <<'EOF'
#!/bin/sh
for c in iptables ip6tables; do
  command -v $c >/dev/null 2>&1 || continue
  while $c -C INPUT -p tcp --dport 80 -j ACCEPT 2>/dev/null; do $c -D INPUT -p tcp --dport 80 -j ACCEPT; done
done
exit 0
EOF
  chmod 755 "$ETC/hooks/pre.sh" "$ETC/hooks/post.sh"
}

le_issue() { # domain email
  local d="$1" email="${2:-}" args
  step "Requesting Let's Encrypt certificate for $d"
  apt_install certbot
  le_hooks
  if ss -H -ltn 'sport = :80' 2>/dev/null | grep -q .; then
    die "Port 80 is in use on this server; Let's Encrypt (standalone) needs it free."
  fi
  args=(certonly --standalone -d "$d" --non-interactive --agree-tos --preferred-challenges http
        --pre-hook "$ETC/hooks/pre.sh" --post-hook "$ETC/hooks/post.sh"
        --deploy-hook "$SELF cert deploy")
  if [[ -n $email ]]; then args+=(-m "$email"); else args+=(--register-unsafely-without-email); fi
  if certbot --help certonly 2>/dev/null | grep -q -- '--key-type'; then args+=(--key-type rsa); fi
  certbot "${args[@]}" || die "certbot failed. Check: DNS A record -> this server, port 80 open in your cloud firewall."
  cmd_cert_deploy "$d"
}

cmd_cert_deploy() {
  local d="${1:-}"; cfg_load
  if [[ -z $d ]]; then          # called by certbot's deploy hook (no argument): only act while in domain mode
    d="${DOMAIN:-}"
    if [[ -z $d || $MODE != domain ]]; then say "Not in domain mode - nothing to deploy."; return 0; fi
  fi
  local live="$LE_DIR/live/$d"
  [[ -f $live/cert.pem ]] || die "No Let's Encrypt certificate found for $d"
  mkdir -p "$SWAN/x509" "$SWAN/x509ica" "$SWAN/private"
  cp -L "$live/cert.pem"    "$SWAN/x509/server.pem"
  cp -L "$live/chain.pem"   "$SWAN/x509ica/le-chain.pem"
  cp -L "$live/privkey.pem" "$SWAN/private/server.key"
  chmod 644 "$SWAN/x509/server.pem" "$SWAN/x509ica/le-chain.pem"; chmod 600 "$SWAN/private/server.key"
  run_swanctl --load-creds >/dev/null 2>&1 || true
  log "LE cert deployed for $d"
}

mode_setup_ip() { # ip
  local ip="$1"
  cfg_set MODE ip; cfg_set SERVER_IP "$ip"; cfg_set SERVER_NAME "$ip"; cfg_set DOMAIN ""
  pki_init_ca
  step "Issuing server certificate for $ip"
  pki_issue_server "$ip"
  rm -f "$SWAN/x509ica/le-chain.pem"
}

mode_setup_domain() { # domain email
  local d="$1" email="${2:-}"
  cfg_load
  if [[ $TESTMODE != 1 ]]; then
    dns_check "$d"; case $? in
      2) die "'$d' has no A record yet. Create an A record pointing to $SERVER_IP and wait a few minutes." ;;
      1) die "'$d' does not point to this server ($SERVER_IP). Fix the A record first." ;;
    esac
  fi
  le_issue "$d" "$email"
  cfg_set MODE domain; cfg_set DOMAIN "$d"; cfg_set SERVER_NAME "$d"; cfg_set EMAIL "$email"
  rm -f "$SWAN/x509ca/ikev2-ca.pem"
}

cmd_domain() { need_root; locked _domain "$@"; }
_domain() {
  case "${1:-}" in
    set)
      local d="${2:-}" email="${3:-}"
      [[ $d =~ $DOMAIN_RE ]] || die "Usage: vpn domain set DOMAIN [EMAIL]"
      [[ -z $email || $email =~ $EMAIL_RE ]] || die "Invalid email address."
      cfg_load
      [[ -n $SERVER_IP ]] || SERVER_IP=$(detect_public_ip) || die "Cannot detect public IP."
      cfg_set SERVER_IP "$SERVER_IP"
      mode_setup_domain "$d" "$email"
      rebuild_conf || die "Config reload failed."
      warn "Server address changed to $d. Re-send profiles to your clients (they must use the new address)."
      ok "Switched to domain mode: $d" ;;
    unset)
      cfg_load
      [[ $MODE == domain ]] || die "Already in IP mode."
      local ip; ip=$(detect_public_ip) || die "Cannot detect public IP."
      mode_setup_ip "$ip"; rebuild_conf || die "Config reload failed."
      warn "Server address changed to $ip. Re-send profiles; clients must trust the CA again."
      ok "Switched to IP mode: $ip" ;;
    *) die "Usage: vpn domain set DOMAIN [EMAIL] | vpn domain unset" ;;
  esac
}

cmd_ip() { need_root; locked _ip "$@"; }
_ip() {
  [[ ${1:-} == refresh ]] || die "Usage: vpn ip refresh"
  cfg_load
  [[ $MODE == ip ]] || die "Only for IP mode. In domain mode just update your DNS A record."
  local ip; ip=$(detect_public_ip) || die "Cannot detect public IP."
  if [[ $ip == "$SERVER_NAME" ]]; then ok "Public IP unchanged ($ip)."; return; fi
  say "IP changed: $SERVER_NAME -> $ip"
  mode_setup_ip "$ip"; rebuild_conf || die "Config reload failed."
  warn "Re-send profiles to clients (new server address)."
}

cmd_cert() {
  # anything that rewrites certificates runs under the global lock (certbot's deploy hook included)
  case "${1:-info}" in
    renew|deploy|auto) [[ -n $_LOCK_FD ]] || { locked cmd_cert "$@"; return $?; } ;;
  esac
  cfg_load
  case "${1:-info}" in
    info)
      say "Mode: $MODE   Server: $SERVER_NAME"
      say "State: $(cert_state)   Days left: $(cert_days_left)"
      openssl x509 -in "$SWAN/x509/server.pem" -noout -subject -issuer -enddate 2>/dev/null ;;
    renew)
      need_root
      if [[ $MODE == ip ]]; then
        pki_init_ca; pki_issue_server "$SERVER_NAME"; run_swanctl --load-creds >/dev/null 2>&1
        ok "Server certificate re-issued (CA unchanged, clients keep working)."
      else
        local f=""; [[ ${2:-} == --force ]] && f="--force-renewal"
        certbot renew $f --deploy-hook "$SELF cert deploy" || die "certbot renew failed"
        ok "Renewal finished."
      fi ;;
    auto)
      need_root
      # a missing or already EXPIRED certificate is renewed too (negative day counts used to be skipped)
      local d; d=$(cert_days_left)
      if [[ $MODE == ip ]]; then
        if [[ $d == none ]] || (( d < 30 )); then cmd_cert renew; fi
      else
        if [[ $d == none ]] || (( d < 10 )); then cmd_cert renew; fi
      fi ;;
    deploy) cmd_cert_deploy ;;
    *) die "Usage: vpn cert info|renew [--force]|auto|deploy" ;;
  esac
}

# ------------------------------------------------------------ strongSwan package upgrade
sw_version() {
  local v
  v=$(swanctl --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+[A-Za-z0-9.~+-]*' | head -1)
  [[ -n $v ]] || v=$(dpkg-query -W -f='${Version}' charon-systemd 2>/dev/null)
  echo "${v:-unknown}"
}

cmd_upgrade_strongswan() {
  need_root
  local old new
  old=$(sw_version)
  step "Updating strongSwan packages via apt (current: $old)"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update >>"$LOGFILE" 2>&1 || warn "apt-get update reported errors (see $LOGFILE)"
  apt-get install -y --only-upgrade strongswan strongswan-swanctl strongswan-pki charon-systemd \
    libcharon-extra-plugins libcharon-extauth-plugins libstrongswan libstrongswan-standard-plugins \
    libstrongswan-extra-plugins libcharon-standard-plugins >>"$LOGFILE" 2>&1 \
    || { tail -n 12 "$LOGFILE" >&2; die "apt upgrade failed"; }
  systemctl disable --now strongswan-starter >/dev/null 2>&1 || true
  svc_restart; sleep 2
  new=$(sw_version)
  if [[ $(svc_active) != active ]]; then die "strongSwan is not running after the update! See: vpn logs"; fi
  run_swanctl --load-all >/dev/null 2>&1 || true
  if run_swanctl --list-conns 2>/dev/null | grep -q '^rw:'; then
    ok "strongSwan updated: $old -> $new (service healthy, connection 'rw' loaded)."
  else
    warn "strongSwan updated ($old -> $new) but connection 'rw' is not loaded. Run: vpn logs"
  fi
}

# ------------------------------------------------------------ backup / restore
# Backups contain private keys (CA, server, Let's Encrypt), every VPN password and the bot token.
# Local copies are root-only (0600 in a 0700 folder). For copies that leave the server the tool
# encrypts to a certificate whose private key stays with YOU (vpn backup key init|set).
backup_archive() { # OUTFILE
  local out="$1" paths=() p
  for p in "$ETC" "$SWAN" "$LE_DIR"; do [[ -e $p ]] && paths+=("${p#/}"); done
  [[ ${#paths[@]} -gt 0 ]] || return 1
  ( umask 077; tar -C / -czf "$out" "${paths[@]}" 2>/dev/null ) || { rm -f "$out"; return 1; }
  chmod 600 "$out"
}

backup_encrypt() { # IN OUT
  openssl cms -encrypt -binary -aes-256-cbc -outform DER -in "$1" -out "$2" -recip "$BACKUP_PUB" 2>/dev/null \
    && chmod 600 "$2"
}

backup_decrypt() { # IN KEY OUT
  openssl cms -decrypt -binary -inform DER -in "$1" -inkey "$2" -out "$3" 2>/dev/null && return 0
  [[ -f $BACKUP_PUB ]] && openssl cms -decrypt -binary -inform DER -in "$1" -inkey "$2" -recip "$BACKUP_PUB" -out "$3" 2>/dev/null
}

backup_prune() { # PATTERN KEEP
  ls -1t $1 2>/dev/null | tail -n +"$(( $2 + 1 ))" | xargs -r rm -f
}

cmd_backup() {
  need_root
  case "${1:-}" in
    key)     shift; locked _backup_key "$@" ;;
    decrypt) shift; _backup_decrypt "$@" ;;
    *)       locked _backup "$@" ;;
  esac
}

_backup() {
  local enc=0 a out stamp
  for a in "$@"; do
    case "$a" in --encrypt) enc=1 ;; *) die "Usage: vpn backup [--encrypt]   |   vpn backup key init|set FILE|show|remove   |   vpn backup decrypt FILE.enc KEY.pem [OUT]" ;; esac
  done
  if [[ $enc == 1 && ! -f $BACKUP_PUB ]]; then die "No backup encryption key yet. Create one first: vpn backup key init"; fi
  mkdir -p "$BACKUPS"; chmod 700 "$BACKUPS"
  stamp=$(date +%Y%m%d-%H%M%S)
  out="$BACKUPS/ikev2-backup-$stamp.tar.gz"
  backup_archive "$out" || die "Backup failed"
  if [[ $enc == 1 ]]; then
    backup_encrypt "$out" "$out.enc" || { rm -f "$out.enc"; die "Encrypting the backup failed (is $BACKUP_PUB a valid certificate?)"; }
  fi
  backup_prune "$BACKUPS/ikev2-backup-*.tar.gz" 10
  backup_prune "$BACKUPS/ikev2-backup-*.tar.gz.enc" 10
  ok "Backup created: $out"
  if [[ $enc == 1 ]]; then ok "Encrypted copy: $out.enc   (the only kind that should ever leave this server)"; fi
  return 0
}

_backup_key() {
  local sub="${1:-show}" t f bits n
  shift || true
  case "$sub" in
    init)
      if [[ -f $BACKUP_PUB && ${1:-} != --force ]]; then
        die "A backup key already exists (see: vpn backup key show). Use --force to replace it - older .enc backups then need the OLD private key."
      fi
      t=$(mktemp -d) || die "mktemp failed"; chmod 700 "$t"
      if ! ( umask 077
             openssl genrsa -out "$t/key.pem" "${IKEV2_BACKUP_KEY_BITS:-4096}" >/dev/null 2>&1 &&
             openssl req -x509 -new -key "$t/key.pem" -subj "/CN=ikev2-manager backup" -days 36500 -out "$t/cert.pem" >/dev/null 2>&1 ); then
        rm -rf "$t"; die "Could not generate the key pair (openssl)."
      fi
      mkdir -p "$ETC"; install -m 644 "$t/cert.pem" "$BACKUP_PUB"
      say "============ BACKUP PRIVATE KEY - copy it NOW to a safe place (password manager / offline) ============"
      say "It is NOT stored on this server. Without it, encrypted (.enc) backups can never be opened."
      cat "$t/key.pem"
      say "============ END OF PRIVATE KEY ============"
      command -v shred >/dev/null 2>&1 && shred -u "$t/key.pem" 2>/dev/null
      rm -rf "$t"
      ok "Backup encryption is now on: vpn backup --encrypt  (the Telegram bot only sends encrypted backups)." ;;
    set)
      f="${1:-}"; [[ -f $f ]] || die "Usage: vpn backup key set CERT.pem   (an X.509 certificate with an RSA key >= 2048 bit; keep its private key yourself)"
      openssl x509 -in "$f" -noout 2>/dev/null || die "That file is not a PEM certificate. Create one on YOUR computer:
  openssl req -x509 -newkey rsa:4096 -nodes -keyout backup.key -out backup.crt -days 36500 -subj /CN=ikev2-backup"
      bits=$(openssl x509 -in "$f" -noout -text 2>/dev/null | sed -n 's/.*Public-Key: (\([0-9]*\) bit).*/\1/p' | head -1)
      openssl x509 -in "$f" -noout -text 2>/dev/null | grep -q 'rsaEncryption' && [[ ${bits:-0} -ge 2048 ]] \
        || die "Only RSA keys of at least 2048 bit are supported."
      mkdir -p "$ETC"; install -m 644 "$f" "$BACKUP_PUB"
      ok "Backup encryption certificate installed. Fingerprint: $(openssl x509 -in "$BACKUP_PUB" -noout -fingerprint -sha256 | cut -d= -f2)" ;;
    show|status)
      if [[ -f $BACKUP_PUB ]]; then
        say "Backup encryption: ON"
        say "Fingerprint: $(openssl x509 -in "$BACKUP_PUB" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2)"
      else
        say "Backup encryption: OFF   (enable: vpn backup key init)"
      fi ;;
    remove)
      rm -f "$BACKUP_PUB"; ok "Backup encryption key removed (existing .enc files stay readable with your private key)." ;;
    *) die "Usage: vpn backup key init [--force] | set CERT.pem | show | remove" ;;
  esac
}

_backup_decrypt() { # FILE.enc KEY.pem [OUT]
  local in="${1:-}" key="${2:-}" out="${3:-}"
  [[ -f $in && -f $key ]] || die "Usage: vpn backup decrypt FILE.enc PRIVATE_KEY.pem [OUT.tar.gz]"
  [[ -n $out ]] || out="${in%.enc}"
  [[ $out != "$in" ]] || die "Give an output file name."
  ( umask 077; backup_decrypt "$in" "$key" "$out" ) || { rm -f "$out"; die "Could not decrypt (wrong key?)."; }
  chmod 600 "$out"; ok "Decrypted to $out"
}

cmd_backups() { ls -1t "$BACKUPS"/ikev2-backup-*.tar.gz "$BACKUPS"/ikev2-backup-*.tar.gz.enc 2>/dev/null; }

cmd_restore() { need_root; locked _restore "$@"; }
_restore() {
  local f="" key="" a want=0 tmp="" pre orig
  for a in "$@"; do
    if [[ $want == 1 ]]; then key="$a"; want=0; continue; fi
    case "$a" in --key) want=1 ;; *) f="$a" ;; esac
  done
  [[ -f $f ]] || die "Usage: vpn restore FILE.tar.gz | FILE.enc --key PRIVATE_KEY.pem   (see: vpn backups)"
  orig="$f"
  if [[ $f == *.enc ]]; then
    [[ -f $key ]] || die "This backup is encrypted: vpn restore FILE.enc --key PRIVATE_KEY.pem"
    tmp=$(mktemp "${TMPDIR:-/tmp}/ikev2-restore.XXXXXX") || die "mktemp failed"
    ( umask 077; backup_decrypt "$f" "$key" "$tmp" ) || { rm -f "$tmp"; die "Could not decrypt the backup (wrong key?). Nothing was changed."; }
    f="$tmp"
  fi
  # never extract an unchecked archive as root: every entry must stay inside the tool's own folders
  if ! python3 "$OPT/ikev2lib.py" check-backup "$f" "${ETC#/}" "${SWAN#/}" "${LE_DIR#/}"; then
    [[ -n $tmp ]] && rm -f "$tmp"
    die "This archive was rejected (reasons above): it is not a plain ikev2-manager backup. Nothing was restored."
  fi
  step "Saving the current state first"
  mkdir -p "$BACKUPS"; chmod 700 "$BACKUPS"
  pre="$BACKUPS/ikev2-prerestore-$(date +%Y%m%d-%H%M%S).tar.gz"
  if backup_archive "$pre"; then say "  (undo copy: $pre)"; else warn "could not create the safety copy"; fi
  backup_prune "$BACKUPS/ikev2-prerestore-*.tar.gz" 3
  step "Restoring $orig"
  if ! tar -C / -xzf "$f"; then [[ -n $tmp ]] && rm -f "$tmp"; die "Restore failed - the previous state is in $pre"; fi
  [[ -n $tmp ]] && rm -f "$tmp"
  cfg_load
  rebuild_conf || warn "Could not regenerate swanctl.conf from the restored data - check: vpn logs"
  run_swanctl --load-creds >/dev/null 2>&1 || true
  svc_restart
  _net_apply
  ok "Restore finished. Services restarted."
}

