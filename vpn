         if [[ ${#items[@]} -eq 0 ]]; then warn " No backups found."; ui_pause; continue; fi
         echo; i=1; for x in "${items[@]}"; do ui_item "$i" "$(basename "$x")"; i=$((i+1)); done; ui_item 0 "Cancel"
         read -rp " Select backup: " ans || continue
         [[ $ans =~ ^[0-9]+$ && $ans -ge 1 && $ans -le ${#items[@]} ]] || continue
         echo; if ui_yesno "Restore $(basename "${items[$((ans-1))]}")? Current users/certs are overwritten." n; then
