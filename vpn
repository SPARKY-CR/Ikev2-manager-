# ---- backup
tui_backup() {
  local items=() x i ans
  while true; do
    ui_header "Backup & restore"
    echo; echo " Folder: $BACKUPS"; echo
    ui_item 1 "Create backup now"
    ui_item 2 "List backups"
    ui_item 3 "Restore a backup"
