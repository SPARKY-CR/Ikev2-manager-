#!/usr/bin/env bash
# Emulates the subset of strongSwan's `pki` that ikev2-manager uses, with openssl.
echo "pki $*" >>"${STUB_STATE:-/tmp}/calls.log" 2>/dev/null
mode="${1:-}"; shift || true
size=2048 in="" dn="" san="" life=365 cacert="" cakey="" ca=0 pathlen="" nc=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --size) size="$2"; shift 2 ;;      --in) in="$2"; shift 2 ;;
    --dn) dn="$2"; shift 2 ;;          --san) san="$2"; shift 2 ;;
    --lifetime) life="$2"; shift 2 ;;  --cacert) cacert="$2"; shift 2 ;;
    --cakey) cakey="$2"; shift 2 ;;    --ca) ca=1; shift ;;
    --pathlen) [[ -n ${STUB_PKI_NO_PATHLEN:-} ]] && { echo "invalid --pathlen option" >&2; exit 2; }; pathlen="$2"; shift 2 ;;
    --nc-permitted) nc="$2"; shift 2 ;;
    --type|--outform|--flag) shift 2 ;;
    *) shift ;;
  esac
done
subj="/$dn"
[[ -n ${STUB_PKI_FAIL:-} && $mode == "$STUB_PKI_FAIL" ]] && { echo "pki stub: simulated failure in $mode" >&2; exit 1; }
case "$mode" in
  --gen)  openssl genrsa "${STUB_PKI_BITS:-$size}" 2>/dev/null ;;
  --self) ext="basicConstraints=critical,CA:TRUE${pathlen:+,pathlen:$pathlen}"
          openssl req -x509 -new -key "$in" -subj "$subj" -days "$life" -addext "$ext" -addext "keyUsage=critical,keyCertSign,cRLSign" 2>/dev/null ;;
  --req)  if [[ $san =~ ^[0-9.]+$ ]]; then s="IP:$san"; else s="DNS:$san"; fi
          openssl req -new -key "$in" -subj "$subj" -addext "subjectAltName=$s" 2>/dev/null ;;
  --issue) ext=$(mktemp); printf 'extendedKeyUsage=serverAuth,1.3.6.1.5.5.7.3.17\nbasicConstraints=CA:FALSE\n' >"$ext"
          openssl x509 -req -in "$in" -CA "$cacert" -CAkey "$cakey" -days "$life" -set_serial "0x$(openssl rand -hex 8)" -extfile "$ext" -copy_extensions copy 2>/dev/null
          rc=$?; rm -f "$ext"; exit $rc ;;
  *) echo "pki stub: unsupported mode $mode" >&2; exit 1 ;;
esac
